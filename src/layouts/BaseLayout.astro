---
import '../styles/global.css';
import HeaderLangSwitcher from '../components/HeaderLangSwitcher.astro';
import SearchBox from '../components/SearchBox.astro';
import PopularSidebar from '../components/PopularSidebar.astro';
import { LOCALES, type Locale } from '../i18n/utils';

interface Props {
  title: string;
  description?: string;
  // 현재 글에 실제로 존재하는 언어 목록. 글 상세 페이지에서 넘겨주면
  // 헤더 드롭다운에서 번역 없는 언어가 정확히 회색 처리된다.
  // 넘기지 않으면(홈/카테고리 목록 등) 전체 언어를 사용 가능한 것으로 간주.
  availableLangs?: Locale[];
  // 글 상세 페이지 전용: 언어별 실제 slug 매핑. HeaderLangSwitcher로 그대로 전달되어
  // "translationKey는 같은데 파일명(slug)이 언어마다 다른" 글에서도 언어전환 링크가
  // 정확한 주소로 연결되게 한다 (없으면 언어 코드만 바꾸는 기존 방식으로 폴백).
  slugOverrides?: Partial<Record<Locale, string>>;
  // true면 좌측에 인기글 사이드바를 배치한다 (데스크탑: sticky 사이드바 / 모바일: 본문 하단).
  // 글 상세 페이지에서만 켜고, 홈/카테고리 목록 페이지는 기본값(false)으로 둔다.
  showSidebar?: boolean;
}
const {
  title,
  description = 'deaf52 · IT & humanities',
  availableLangs,
  slugOverrides,
  showSidebar = false,
} = Astro.props;

const currentPath = Astro.url.pathname;
const currentLang: Locale = (LOCALES as readonly string[]).includes(currentPath.split('/')[1])
  ? (currentPath.split('/')[1] as Locale)
  : 'ko';
---
<!doctype html>
<html lang={currentLang}>
<head>
  <!-- Google Tag Manager -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-TFW86BDB');</script>
  <!-- End Google Tag Manager -->
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} · deaf52</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="description" content={description} />
  <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
  <link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.css"
  />
  <link
    href="https://fonts.googleapis.com/css2?family=Noto+Serif+KR:wght@500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap"
    rel="stylesheet"
  />
  <link
    rel="alternate"
    type="application/rss+xml"
    title={`deaf52 (${currentLang})`}
    href={`/${currentLang}/rss.xml`}
  />
</head>
<body>
  <!-- Google Tag Manager (noscript) -->
  <noscript>
    <iframe src="https://www.googletagmanager.com/ns.html?id=GTM-TFW86BDB" height="0" width="0" style="display:none;visibility:hidden"></iframe>
  </noscript>
  <!-- End Google Tag Manager (noscript) -->
  <header class="site-header">
    <a href={`/${currentLang}/`} class="site-title-group">
      <span class="site-title">deaf52</span>
      <span class="site-subtitle">IT &amp; humanities</span>
    </a>
    <nav class="site-nav">
      <HeaderLangSwitcher
        currentLang={currentLang}
        currentPath={currentPath}
        availableLangs={availableLangs}
        slugOverrides={slugOverrides}
      />
      <SearchBox />
      <a href={`/${currentLang}/it/`}>IT기술</a>
      <a href={`/${currentLang}/humanities/`}>인문학</a>
    </nav>
  </header>

  {showSidebar ? (
    <div class="page-with-sidebar">
      <PopularSidebar lang={currentLang} />
      <main class="page-shell page-shell-with-sidebar">
        <slot />
      </main>
    </div>
  ) : (
    <main class="page-shell">
      <slot />
    </main>
  )}

  <footer class="site-footer">
    <p>
      &copy; 2026 deaf52.dev &middot; <a href="mailto:deaf525252@gmail.com">deaf525252@gmail.com</a>
      &middot; <a href={`/${currentLang}/rss.xml`}>RSS</a>
      &middot; <a
        href="https://ko-fi.com/B1L125QQRV"
        target="_blank"
        rel="noopener noreferrer"
        class="kofi-link"
        onclick="window.dataLayer && window.dataLayer.push({event: 'kofi_click'})"
      >☕ ko-fi</a>
      &middot; <span id="site-visit-counter">방문자수 불러오는 중...</span>
    </p>
  </footer>
  <script>
    fetch('/api/counter/site')
      .then((res) => res.json())
      .then((data) => {
        const el = document.getElementById('site-visit-counter');
        if (el) el.textContent = `누적 방문 ${data.count.toLocaleString()}`;
      })
      .catch(() => {
        const el = document.getElementById('site-visit-counter');
        if (el) el.textContent = '';
      });
  </script>
</body>
</html>
