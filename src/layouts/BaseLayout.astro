---
import '../styles/global.css';
import HeaderLangSwitcher from '../components/HeaderLangSwitcher.astro';

interface Props {
  title: string;
  description?: string;
}
const { title, description = 'deaf52 · IT & humanities' } = Astro.props;

const currentPath = Astro.url.pathname;
const currentLang: 'ko' | 'en' = currentPath.startsWith('/en') ? 'en' : 'ko';
---
<!doctype html>
<html lang={currentLang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} · deaf52</title>
  <meta name="description" content={description} />
  <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
  <link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.css"
  />
  <link
    href="https://fonts.googleapis.com/css2?family=Noto+Serif+KR:wght@500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap"
    rel="stylesheet"
  />
</head>
<body>
  <header class="site-header">
    <a href="/" class="site-title-group">
      <span class="site-title">deaf52</span>
      <span class="site-subtitle">IT &amp; humanities</span>
    </a>
    <nav class="site-nav">
      <HeaderLangSwitcher currentLang={currentLang} currentPath={currentPath} />
      
      <a href={`/${currentLang}/it/`} class="nav-category">
        IT기술
        <span class="sub-indicator" aria-hidden="true">
          <span></span><span></span><span></span>
        </span>
      </a>
    
      <a href={`/${currentLang}/humanities/`} class="nav-category">
        인문학
        <span class="sub-indicator" aria-hidden="true">
          <span></span><span></span><span></span>
        </span>
      </a>
    </nav>
  </header>
  <main class="page-shell">
    <slot />
  </main>
  <footer class="site-footer">
    <p>&copy; 2026 deaf52.dev &middot; <a href="mailto:eorms96@naver.com">eorms96@naver.com</a></p>
  </footer>
</body>
</html>
