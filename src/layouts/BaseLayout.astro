---
import '../styles/global.css';
import HeaderLangSwitcher from '../components/HeaderLangSwitcher.astro';
import SearchBox from '../components/SearchBox.astro';
import { LOCALES, type Locale } from '../i18n/utils';

interface Props {
  title: string;
  description?: string;
  // 현재 글에 실제로 존재하는 언어 목록. 글 상세 페이지에서 넘겨주면
  // 헤더 드롭다운에서 번역 없는 언어가 정확히 회색 처리된다.
  // 넘기지 않으면(홈/카테고리 목록 등) 전체 언어를 사용 가능한 것으로 간주.
  availableLangs?: Locale[];
}
const { title, description = 'deaf52 · IT & humanities', availableLangs } = Astro.props;

const currentPath = Astro.url.pathname;
const currentLang: Locale = (LOCALES as readonly string[]).includes(currentPath.split('/')[1])
  ? (currentPath.split('/')[1] as Locale)
  : 'ko';
---
<!doctype html>
<html lang={currentLang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} · deaf52</title>
  <meta name="description" content={description} />
  <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
  <link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.css"
  />
  <link
    href="https://fonts.googleapis.com/css2?family=Noto+Serif+KR:wght@500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap"
    rel="stylesheet"
  />
</head>
<body>
  <header class="site-header">
    <a href="/" class="site-title-group">
      <span class="site-title">deaf52</span>
      <span class="site-subtitle">IT &amp; humanities</span>
    </a>
    <nav class="site-nav">
      <HeaderLangSwitcher currentLang={currentLang} currentPath={currentPath} availableLangs={availableLangs} />
      <SearchBox />
      <span class="nav-label">menu</span>
      <a href={`/${currentLang}/it/`}>IT기술</a>
      <a href={`/${currentLang}/humanities/`}>인문학</a>
    </nav>
  </header>
  <main class="page-shell">
    <slot />
  </main>
  <footer class="site-footer">
    <p>
      &copy; 2026 deaf52.dev &middot; <a href="mailto:eorms96@naver.com">eorms96@naver.com</a>
      &middot; <span id="site-visit-counter">방문자수 불러오는 중...</span>
    </p>
  </footer>
  <script>
    fetch('/api/counter/site')
      .then((res) => res.json())
      .then((data) => {
        const el = document.getElementById('site-visit-counter');
        if (el) el.textContent = `누적 방문 ${data.count.toLocaleString()}`;
      })
      .catch(() => {
        const el = document.getElementById('site-visit-counter');
        if (el) el.textContent = '';
      });
  </script>
</body>
</html>
