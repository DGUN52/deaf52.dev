    color: var(--tech);
  }

  .editor-body-toolbar {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: -0.75rem;
  }

  .editor-body-toolbar button {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    min-width: 2.1rem;
    padding: 0.35rem 0.6rem;
    border: 1px solid var(--line);
    border-radius: 4px;
