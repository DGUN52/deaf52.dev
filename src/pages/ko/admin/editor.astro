---
// md 글 작성/수정용 관리자 에디터 페이지.
// 이 경로 자체는 Cloudflare Access(대시보드 설정)로 이메일 인증 보호되는 것을 전제로 한다.
// 로그인 UI/세션 관리는 이 페이지에 없다 — 접근 자체가 Access 뒤에서만 허용됨.
// 다국어 사이트지만 이 페이지는 관리자 본인만 쓰는 페이지이므로 한국어 고정, [lang] 라우팅 밖에 둔다.
//
// 저장 방식: 이 에디터는 GitHub API로 기존 글을 "읽기"만 한다(/api/editor/posts, Worker의
// GITHUB_READ_TOKEN 사용). content 저장소는 private repo라 Worker가 여기 직접 쓸 방법이
// 마땅치 않고(별도 쓰기 토큰 + 커밋 API 왕복이 필요해 배보다 배꼽이 커짐), 대신 "저장" 버튼은
// frontmatter+본문을 조합한 .md 파일을 브라우저가 즉시 다운로드하게 만든다.
// 관리자가 다운로드된 파일을 로컬 content 폴더(it/{lang}/ 또는 humanities/{lang}/)에 옮기고
// 직접 git add/commit/push 하는 것으로 게시가 완료된다 (기존 번역 스크립트 워크플로우와 동일한 결).
export const prerender = true;
import '../../../styles/global.css';
---

<!doctype html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>글 에디터 · deaf52</title>
</head>
<body>
  <main class="editor-shell">
    <div class="editor-head">
      <h1>글 에디터</h1>
      <a href="/ko/admin/reports" class="editor-sub-link">← 번역 신고 관리로</a>
    </div>

    <div class="editor-toolbar">
      <select id="ed-category" title="카테고리">
        <option value="it">IT기술</option>
        <option value="humanities">인문학</option>
      </select>
      <select id="ed-existing" title="기존 글 불러오기">
        <option value="">— 새 글 작성 —</option>
      </select>
      <button type="button" id="ed-load-list" title="목록 새로고침">⟳</button>
      <button type="button" id="ed-connect-images" title="로컬 public/images 폴더를 연결하면, 본문/드래그드롭한 글에 쓰인 이미지 파일명을 그 폴더에서 자동으로 찾아 미리보기에 보여줍니다 (배포 사이트에 아직 없는 새 이미지도 미리 확인 가능)">🖼 이미지 폴더 연결</button>
      <button type="button" id="ed-connect-content" title="로컬 content 레포 폴더(it/, humanities/ 있는 최상위)를 연결하면, PostCard로 참조한 글의 제목/설명을 API 없이 로컬 파일에서 바로 찾아 미리보기에 보여줍니다 (로컬 dev 서버에서 유용 - Worker API는 배포 환경에서만 응답함)">🔖 콘텐츠 폴더 연결</button>
      <span class="editor-toolbar-hint">"새 글 작성" 상태에서 .md/.mdx 파일을 드래그하면 불러옵니다</span>
      <span id="ed-status" class="editor-status"></span>
    </div>

    <form id="ed-form" class="editor-form">
      <div class="editor-meta-block">
        <div class="editor-grid">
          <label class="field-wide">
            제목 (title)
            <input type="text" id="fm-title" required />
          </label>

          <label class="field-wide">
            설명 (description)
            <input type="text" id="fm-description" required />
          </label>

          <label class="field-narrow">
            언어
            <select id="fm-lang">
              <option value="ko">ko</option>
              <option value="en">en</option>
              <option value="ja">ja</option>
              <option value="zh">zh</option>
              <option value="in">in</option>
              <option value="de">de</option>
              <option value="uk">uk</option>
              <option value="il">il</option>
              <option value="tw">tw</option>
            </select>
          </label>

          <label class="field-narrow">
            발행일
            <input type="date" id="fm-publishedAt" required />
          </label>

          <label class="field-narrow editor-checkbox-field">
            <input type="checkbox" id="fm-draft" />
            draft
          </label>

          <label class="field-wide">
            slug (파일명, 확장자 제외)
            <input type="text" id="fm-slug" required />
          </label>

          <label class="field-wide">
            translationKey
            <input type="text" id="fm-translationKey" required />
          </label>

          <label class="field-wide editor-heroimage-field">
            heroImage (선택)
            <div class="editor-combo-row">
              <select id="fm-heroImage-select">
                <option value="">— 직접 입력 —</option>
              </select>
              <button type="button" id="hero-browse" class="editor-browse-btn" title="컴퓨터에서 파일 선택 (파일명만 가져옵니다)">📂</button>
              <input type="file" id="hero-file-picker" accept="image/*" hidden />
              <input type="text" id="fm-heroImage" placeholder="/images/xxx.jpg" />
            </div>
          </label>
        </div>

        <div class="editor-tech-field" id="fm-tech-wrap">
          <div class="editor-tech-label-row">
            <span class="editor-tech-label">기술 태그 (tech)</span>
            <button type="button" id="tags-refresh" title="기존 IT 글들을 훑어서 태그 목록을 새로 만듭니다">태그 목록 갱신</button>
          </div>
          <div id="tech-checkbox-list" class="editor-tech-checkbox-list"></div>
          <input type="text" id="fm-tech-extra" placeholder="목록에 없는 태그 직접 입력 (쉼표로 구분)" />
        </div>

        <div class="editor-img-helper">
          <select id="img-select" title="이미지 선택">
            <option value="">— 직접 입력 —</option>
          </select>
          <button type="button" id="img-browse" class="editor-browse-btn" title="컴퓨터에서 파일 선택 (파일명만 가져옵니다)">📂</button>
          <input type="file" id="img-file-picker" accept="image/*" hidden />
          <input type="text" id="img-filename" placeholder="파일명 (예: photo1.jpg)" />
          <input type="text" id="img-alt" placeholder="설명(alt)" />
          <button type="button" id="img-insert">본문에 삽입</button>
        </div>
      </div>

      <div class="editor-body-toolbar">
        <button type="button" id="tb-bold" title="굵게 (Ctrl+B)"><strong>B</strong></button>
        <button type="button" id="tb-italic" title="기울임 (Ctrl+I)"><em>I</em></button>
        <button type="button" id="tb-underline" title="밑줄 (Ctrl+U)"><u>U</u></button>
        <button type="button" id="tb-strike" title="취소선 (Ctrl+Shift+S)"><s>S</s></button>
        <button type="button" id="tb-link" title="링크">🔗</button>
        <button type="button" id="tb-image" title="이미지">🖼</button>
        <button type="button" id="tb-bookmark" title="북마크 카드 삽입 (본문에 /북마크 라고 입력해도 열립니다)">🔖</button>
        <span class="editor-body-toolbar-spacer"></span>
        <button type="button" id="tb-preview">미리보기 숨기기</button>
      </div>

      <div class="editor-body-split" id="ed-body-split">
        <label class="editor-body-field">
          본문 (Markdown)
          <textarea id="ed-body" rows="20" placeholder="# 제목&#10;&#10;본문을 마크다운으로 작성하세요..."></textarea>
        </label>
        <div class="editor-preview-field">
          미리보기
          <div id="ed-preview" class="editor-preview"></div>
        </div>
      </div>

      <div class="editor-actions">
        <button type="button" id="ed-download">.md 파일 다운로드</button>
        <button type="button" id="ed-clear-draft">임시저장 초기화</button>
        <span class="editor-hint">
          다운로드한 파일을 <code>content/{'{'}category{'}'}/{'{'}lang{'}'}/</code> 폴더에 넣고 git commit/push 하세요.
        </span>
      </div>
    </form>

    <div id="ed-drop-overlay" class="editor-drop-overlay" hidden>
      <div class="editor-drop-overlay-box">📄 .md 파일을 여기에 놓으세요</div>
    </div>

    <div id="ed-bookmark-modal" class="editor-modal-overlay" hidden>
      <div class="editor-modal">
        <div class="editor-modal-head">
          <span>🔖 북마크로 넣을 글 선택</span>
          <button type="button" id="ed-bookmark-close" aria-label="닫기">✕</button>
        </div>
        <input
          type="text"
          id="ed-bookmark-search"
          class="editor-modal-search"
          placeholder="제목 또는 slug로 검색..."
        />
        <div id="ed-bookmark-list" class="editor-modal-list">
          <p class="editor-modal-empty">글 목록 불러오는 중...</p>
        </div>
      </div>
    </div>
  </main>
</body>
</html>

<script src="https://cdnjs.cloudflare.com/ajax/libs/marked/12.0.2/marked.min.js" is:inline></script>

<style is:global>
  .editor-shell {
    max-width: 1600px;
    margin: 0 auto;
    padding: 0.75rem 1.5rem 2rem;
    font-family: var(--font-mono);
  }

  .editor-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.4rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--line);
  }

  .editor-head h1 {
    font-size: 1.1rem;
    margin: 0;
  }

  .editor-sub-link {
    font-size: 0.76rem;
    color: var(--tech);
    white-space: nowrap;
  }

  .editor-toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
    margin-bottom: 0.6rem;
  }

  .editor-toolbar select,
  .editor-toolbar button {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    padding: 0.3rem 0.5rem;
    border: 1px solid var(--line);
    border-radius: 4px;
    background: #fff;
  }

  .editor-toolbar select {
    max-width: 200px;
  }

  .editor-toolbar button {
    cursor: pointer;
  }

  .editor-toolbar button:hover {
    border-color: var(--tech);
    color: var(--tech);
  }

  .editor-toolbar button:disabled {
    cursor: not-allowed;
    opacity: 0.45;
  }

  .editor-toolbar button:disabled:hover {
    border-color: var(--line);
    color: inherit;
  }

  .editor-toolbar-hint {
    font-size: 0.74rem;
    color: var(--ink-soft);
    opacity: 0.75;
  }

  .editor-status {
    font-size: 0.78rem;
    color: var(--ink-soft);
  }

  .editor-status.error {
    color: #b23b3b;
  }

  .editor-form {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  /* 상단 메타정보 블록(제목/설명/slug 등 + 기술태그 + 이미지 삽입도우미)을 하나로 묶어서
     본문/미리보기처럼 넓은 폭을 쓸 필요가 없게 자체 max-width를 주고, 배경색으로 구분한다. */
  .editor-meta-block {
    max-width: 900px;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    padding: 0.75rem 0.9rem;
    background: var(--paper-deep);
    border: 1px solid var(--line);
    border-radius: 6px;
  }

  .editor-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
    padding-bottom: 0.65rem;
    border-bottom: 1px dashed var(--line);
  }

  .editor-grid label {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-size: 0.78rem;
    color: var(--ink-soft);
  }

  .editor-grid .field-wide {
    flex: 1 1 260px;
  }

  .editor-grid .field-narrow {
    flex: 0 1 110px;
  }

  .editor-grid .editor-heroimage-field {
    flex-basis: 100%;
  }

  .editor-checkbox-field {
    flex-direction: row !important;
    align-items: center;
    justify-content: center;
    gap: 0.4rem !important;
    flex: 0 0 auto !important;
    padding: 0 0.5rem;
    border: 1px solid var(--line);
    border-radius: 4px;
    align-self: stretch;
  }

  .editor-grid input,
  .editor-grid select {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    padding: 0.4rem 0.55rem;
    border: 1px solid var(--line);
    border-radius: 4px;
  }

  .editor-body-split {
    display: grid;
    /* 1fr 단독으로는 grid 트랙의 min-width가 auto라서 폭이 넓은 이미지 같은 콘텐츠가
       트랙 자체를 밀어 넘칠 수 있다 (아이템에 min-width:0을 줘도 트랙 레벨에서는 안 먹음).
       minmax(0, 1fr)로 트랙 자체의 최소 폭을 0으로 고정해서 막는다. */
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 0.75rem;
    align-items: stretch;
  }

  .editor-body-split.preview-off {
    grid-template-columns: minmax(0, 1fr);
  }

  .editor-body-split.preview-off .editor-preview-field {
    display: none;
  }

  .editor-body-field,
  .editor-preview-field {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    font-size: 0.8rem;
    color: var(--ink-soft);
    min-width: 0;
  }

  .editor-body-field textarea {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    line-height: 1.6;
    padding: 0.75rem;
    border: 1px solid var(--line);
    border-radius: 4px;
    /* 미리보기(.editor-preview)와 스크롤이 따로 놀도록, 여기도 높이를 화면 기준으로 고정하고
       내부에서만 스크롤되게 한다 - resize:vertical로 늘려도 그 늘어난 높이가 상한이 되어
       늘어난 만큼만 더 스크롤된다 (본문 전체가 늘어나며 페이지 자체가 길어지는 것을 막음). */
    resize: vertical;
    height: calc(100vh - 420px);
    min-height: 460px;
    max-height: 80vh;
    overflow-y: auto;
    box-sizing: border-box;
  }

  @media (max-width: 860px) {
    .editor-body-split {
      grid-template-columns: minmax(0, 1fr);
    }

    /* 모바일에선 편집창+미리보기가 세로로 쌓이므로, 데스크톱 기준 calc(100vh - 420px)를
       그대로 쓰면 위아래로 화면을 꽉 채워 스크롤이 과하게 길어진다. 고정값으로 낮춘다. */
    .editor-body-field textarea,
    .editor-preview {
      height: 50vh;
      max-height: 50vh;
    }
  }

  .editor-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  #ed-download {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    padding: 0.6rem 1.2rem;
    border: 1px solid var(--tech);
    border-radius: 4px;
    background: var(--tech);
    color: #fff;
    cursor: pointer;
  }

  #ed-download:hover {
    opacity: 0.85;
  }

  .editor-hint {
    font-size: 0.78rem;
    color: var(--ink-soft);
  }

  .editor-hint code {
    background: var(--tech-soft);
    padding: 0.1rem 0.3rem;
    border-radius: 3px;
  }

  .editor-img-helper {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    align-items: center;
  }

  .editor-img-helper select,
  .editor-img-helper input,
  .editor-img-helper button {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    padding: 0.35rem 0.55rem;
    border: 1px solid var(--line);
    border-radius: 4px;
  }

  .editor-img-helper select {
    max-width: 150px;
  }

  .editor-img-helper input {
    flex: 1 1 130px;
  }

  .editor-img-helper button {
    background: #fff;
    cursor: pointer;
    white-space: nowrap;
  }

  .editor-img-helper button:hover {
    border-color: var(--tech);
    color: var(--tech);
  }

  .editor-combo-row {
    display: flex;
    gap: 0.5rem;
  }

  .editor-combo-row select {
    flex: 0 0 130px;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    padding: 0.4rem 0.55rem;
    border: 1px solid var(--line);
    border-radius: 4px;
  }

  .editor-combo-row input {
    flex: 1;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    padding: 0.4rem 0.55rem;
    border: 1px solid var(--line);
    border-radius: 4px;
  }

  .editor-browse-btn {
    flex: 0 0 auto;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    padding: 0.35rem 0.55rem;
    border: 1px solid var(--line);
    border-radius: 4px;
    background: #fff;
    cursor: pointer;
    line-height: 1;
  }

  .editor-browse-btn:hover {
    border-color: var(--tech);
    color: var(--tech);
  }

  .editor-tech-field {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: 0.8rem;
    color: var(--ink-soft);
  }

  .editor-tech-label-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .editor-tech-label-row button {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    padding: 0.3rem 0.6rem;
    border: 1px solid var(--line);
    border-radius: 4px;
    background: #fff;
    cursor: pointer;
  }

  .editor-tech-label-row button:hover {
    border-color: var(--tech);
    color: var(--tech);
  }

  .editor-tech-checkbox-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.8rem;
    padding: 0.6rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: 4px;
    min-height: 2.4rem;
  }

  .editor-tech-checkbox-list:empty::after {
    content: '태그 목록이 비어 있습니다. "태그 목록 갱신"을 눌러 채우세요.';
    color: var(--ink-soft);
    font-size: 0.78rem;
  }

  .editor-tech-checkbox-list label {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.82rem;
    cursor: pointer;
  }

  #fm-tech-extra {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    padding: 0.5rem 0.6rem;
    border: 1px solid var(--line);
    border-radius: 4px;
  }

  .editor-body-toolbar {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .editor-body-toolbar button {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    min-width: 2.1rem;
    padding: 0.35rem 0.6rem;
    border: 1px solid var(--line);
    border-radius: 4px;
    background: #fff;
    cursor: pointer;
  }

  .editor-body-toolbar button:hover {
    border-color: var(--tech);
    color: var(--tech);
  }

  .editor-body-toolbar button.active {
    background: var(--tech);
    border-color: var(--tech);
    color: #fff;
  }

  .editor-body-toolbar-spacer {
    flex: 1;
  }

  /* 아래 .editor-preview 하위 규칙들은 실제 사이트의 .post-body 타이포그래피(src/styles/global.css)를
     그대로 옮겨온 것이다 - 에디터 미리보기가 실제 글 페이지와 다르게 보이던 문제를 고치기 위함.
     사이트 쪽 .post-body 스타일이 바뀌면 여기도 같이 맞춰줘야 한다. */
  .editor-preview {
    font-family: var(--font-sans);
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--ink);
    padding: 1rem 1.25rem;
    border: 1px solid var(--line);
    border-radius: 4px;
    /* 편집창(textarea)과 같은 방식으로 높이를 고정해서 독립 스크롤로 만든다.
       기존엔 min-height만 있고 상한이 없어 내용이 길어지면 미리보기 자체가 늘어나며
       페이지 스크롤에 편입됐다 - 이제 편집창 높이와 맞춰 둘 다 자기 영역 안에서만 스크롤된다. */
    height: calc(100vh - 420px);
    min-height: 460px;
    max-height: 80vh;
    min-width: 0;
    max-width: 100%;
    overflow-wrap: break-word;
    overflow-y: auto;
    overflow-x: hidden;
    box-sizing: border-box;
  }

  .editor-preview p {
    margin: 0 0 1.2rem;
  }

  /* 실제 사이트(global.css의 .post-body :not(pre) > code)는 --tech-soft/--tech(차가운
     파란색)에서 --human-soft/--human(버건디 계열, 종이 배경과 색온도가 맞음)로 바꿨는데,
     이 미리보기 쪽은 그 변경이 반영 안 된 채 예전 파란색으로 남아있었다 - 미리보기와
     실제 렌더링이 다르게 보이는 원인. 같은 값으로 맞춘다. */
  .editor-preview :not(pre) > code {
    font-family: var(--font-mono);
    font-size: 0.88em;
    font-weight: 500;
    background: var(--human-soft);
    color: var(--human);
    padding: 0.15em 0.4em;
    border-radius: 4px;
    word-break: break-word;
  }

  .editor-preview pre {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    line-height: 1.6;
    background: var(--ink);
    color: #e8e2d0;
    padding: 1.1rem 1.25rem;
    border-radius: 8px;
    overflow-x: auto;
    margin: 0 0 1.5rem;
  }

  .editor-preview pre code {
    font-family: inherit;
    background: none;
    color: inherit;
    padding: 0;
    border-radius: 0;
    white-space: pre;
  }

  .editor-preview blockquote {
    margin: 0 0 1.5rem;
    padding: 0.2rem 1.1rem;
    border-left: 3px solid var(--human);
    color: var(--ink-soft);
    font-style: italic;
  }

  /* 실제 사이트(global.css의 .post-body blockquote)와 같은 문제 - blockquote 안
     마지막 자식의 margin-bottom이 남아있으면 border-left가 그 빈 공간까지 늘어져
     보인다. 미리보기도 실제 사이트와 동일하게 보이는 게 목적이므로 같이 맞춘다. */
  .editor-preview blockquote > :last-child {
    margin-bottom: 0;
  }

  /* 실제 사이트(global.css의 .post-body hr)와 동일 - 구분선(마크다운 ---)도
     blockquote와 같은 --human(버건디) 계열로 통일. */
  .editor-preview hr {
    border: none;
    border-top: 1px solid var(--human);
    opacity: 0.4;
    margin: 2.5rem 0;
  }

  .editor-preview ul,
  .editor-preview ol {
    margin: 0 0 1.2rem;
    padding-left: 1.4rem;
  }

  .editor-preview li {
    margin-bottom: 0.4rem;
  }

  .editor-preview h2,
  .editor-preview h3 {
    font-family: var(--font-serif);
    margin: 2rem 0 1rem;
  }

  .editor-preview img {
    display: block;
    max-width: 100%;
    height: auto;
    width: auto;
    border-radius: 6px;
    margin: 1rem 0;
  }

  .editor-preview table {
    display: block;
    max-width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: 0.9rem;
  }

  .editor-preview th,
  .editor-preview td {
    border: 1px solid var(--line);
    padding: 0.5rem 0.75rem;
    text-align: left;
  }

  .editor-preview th {
    background: var(--paper-deep);
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  /* 실제 사이트(global.css)의 표 좌측 제목열 스타일과 동일 규칙.
     표에서 좌측 열로 만들고 싶은 칸을 **볼드**로 쓰면 이 스타일이 적용된다. */
  .editor-preview td:first-child:has(> strong:only-child) {
    background: var(--paper-deep);
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  .editor-preview a {
    color: var(--tech);
    text-decoration-color: var(--line);
    text-underline-offset: 2px;
  }

  .editor-preview a:hover {
    text-decoration-color: var(--tech);
  }

  /* 실제 사이트(PostCard.astro)의 북마크 카드 스타일과 동일 규칙 - 미리보기와
     실제 글 페이지가 다르게 보이면 안 된다는 이 프로젝트의 관례를 따름. */
  .editor-preview .post-card {
    display: flex;
    align-items: stretch;
    gap: 1rem;
    margin: 1.75rem 0;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--paper-deep);
    text-decoration: none;
    color: inherit;
    overflow: hidden;
    cursor: default;
  }

  .editor-preview .post-card-thumb {
    flex: 0 0 120px;
    width: 120px;
    height: auto;
    object-fit: cover;
    margin: 0;
  }

  .editor-preview .post-card-body {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 1rem 0 1rem 1rem;
  }

  .editor-preview .post-card:has(.post-card-thumb) .post-card-body {
    padding-left: 0;
  }

  .editor-preview .post-card-title {
    display: block;
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 1rem;
    color: var(--ink-soft);
    margin-bottom: 0.35rem;
  }

  .editor-preview .post-card-desc {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--ink-soft);
    opacity: 0.75;
  }

  .editor-preview .post-card-domain {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--tech);
    margin-top: 0.5rem;
  }

  .editor-preview .post-card-arrow {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    padding: 0 1rem;
    font-size: 1.1rem;
    color: var(--tech);
    opacity: 0.6;
  }

  .editor-preview .post-card-placeholder {
    margin: 1.75rem 0;
    padding: 0.75rem 1rem;
    border: 1px dashed var(--line);
    border-radius: 6px;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--ink-soft);
    opacity: 0.7;
  }

  #ed-clear-draft {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    padding: 0.5rem 1rem;
    border: 1px solid var(--line);
    border-radius: 4px;
    background: #fff;
    cursor: pointer;
  }

  #ed-clear-draft:hover {
    border-color: #b23b3b;
    color: #b23b3b;
  }

  .editor-drop-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.45);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1000;
    cursor: pointer;
  }

  /* hidden 속성의 기본 동작(display:none)이 위 .editor-drop-overlay의 display:flex에
     밀려 무시되는 문제 - 이 규칙으로 hidden일 때 확실히 안 보이게 강제한다. */
  .editor-drop-overlay[hidden] {
    display: none;
  }

  .editor-drop-overlay-box {
    font-family: var(--font-mono);
    font-size: 1.2rem;
    font-weight: bold;
    padding: 2rem 3rem;
    background: #fff;
    border: 3px dashed var(--tech);
    border-radius: 8px;
    color: var(--tech);
  }

  /* ---------- 북마크 카드 선택 모달 ---------- */
  .editor-modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.45);
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: 12vh;
    z-index: 1100;
  }

  /* .editor-drop-overlay와 같은 이유 - hidden이 display:flex에 밀리지 않게 강제 */
  .editor-modal-overlay[hidden] {
    display: none;
  }

  .editor-modal {
    width: min(480px, 90vw);
    max-height: 70vh;
    display: flex;
    flex-direction: column;
    background: var(--paper, #fff);
    border: 1px solid var(--line);
    border-radius: 8px;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.25);
    overflow: hidden;
  }

  .editor-modal-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--line);
    font-weight: bold;
    color: var(--ink-soft);
  }

  .editor-modal-head button {
    background: none;
    border: none;
    cursor: pointer;
    font-size: 1rem;
    color: var(--ink-soft);
    opacity: 0.6;
  }

  .editor-modal-head button:hover {
    opacity: 1;
  }

  .editor-modal-search {
    margin: 0.75rem 1rem 0.5rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: 4px;
    font-size: 0.9rem;
  }

  .editor-modal-list {
    overflow-y: auto;
    padding: 0.25rem 0.5rem 0.75rem;
  }

  .editor-modal-item {
    display: block;
    width: 100%;
    text-align: left;
    padding: 0.5rem 0.75rem;
    border: none;
    background: none;
    border-radius: 4px;
    cursor: pointer;
    color: var(--ink-soft);
  }

  .editor-modal-item:hover {
    background: var(--paper-deep);
  }

  .editor-modal-item-title {
    display: block;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .editor-modal-item-meta {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    opacity: 0.6;
    margin-top: 0.15rem;
  }

  .editor-modal-empty {
    padding: 1rem 0.75rem;
    font-size: 0.85rem;
    color: var(--ink-soft);
    opacity: 0.6;
  }
</style>

<script>
  type ExistingPost = { category: 'it' | 'humanities'; slug: string };

  const categorySelect = document.getElementById('ed-category') as HTMLSelectElement;
  const existingSelect = document.getElementById('ed-existing') as HTMLSelectElement;
  const loadListBtn = document.getElementById('ed-load-list')!;
  const statusEl = document.getElementById('ed-status')!;
  const downloadBtn = document.getElementById('ed-download')!;
  const clearDraftBtn = document.getElementById('ed-clear-draft')!;
  const bodyEl = document.getElementById('ed-body') as HTMLTextAreaElement;
  const previewEl = document.getElementById('ed-preview')!;
  const previewToggleBtn = document.getElementById('tb-preview')!;
  const bodySplitEl = document.getElementById('ed-body-split')!;

  const boldBtn = document.getElementById('tb-bold')!;
  const italicBtn = document.getElementById('tb-italic')!;
  const underlineBtn = document.getElementById('tb-underline')!;
  const strikeBtn = document.getElementById('tb-strike')!;
  const linkBtn = document.getElementById('tb-link')!;
  const imageBtn = document.getElementById('tb-image')!;
  const bookmarkBtn = document.getElementById('tb-bookmark')!;

  const bookmarkModal = document.getElementById('ed-bookmark-modal')!;
  const bookmarkCloseBtn = document.getElementById('ed-bookmark-close')!;
  const bookmarkSearchInput = document.getElementById('ed-bookmark-search') as HTMLInputElement;
  const bookmarkListEl = document.getElementById('ed-bookmark-list')!;

  const imgAltInput = document.getElementById('img-alt') as HTMLInputElement;
  const imgFilenameInput = document.getElementById('img-filename') as HTMLInputElement;
  const imgInsertBtn = document.getElementById('img-insert')!;
  const imgSelect = document.getElementById('img-select') as HTMLSelectElement;
  const imgBrowseBtn = document.getElementById('img-browse')!;
  const imgFilePicker = document.getElementById('img-file-picker') as HTMLInputElement;

  const heroBrowseBtn = document.getElementById('hero-browse')!;
  const heroFilePicker = document.getElementById('hero-file-picker') as HTMLInputElement;

  const techWrap = document.getElementById('fm-tech-wrap')!;

  const tagsRefreshBtn = document.getElementById('tags-refresh')!;
  const techCheckboxList = document.getElementById('tech-checkbox-list')!;
  const techExtraInput = document.getElementById('fm-tech-extra') as HTMLInputElement;
  const heroImageSelect = document.getElementById('fm-heroImage-select') as HTMLSelectElement;

  // marked (CDN, 이 관리자 페이지에만 로드됨 - 사이트 다른 페이지 로딩 속도엔 영향 없음)
  declare const marked: { parse(md: string): string };

  const fields = {
    title: document.getElementById('fm-title') as HTMLInputElement,
    description: document.getElementById('fm-description') as HTMLInputElement,
    lang: document.getElementById('fm-lang') as HTMLSelectElement,
    translationKey: document.getElementById('fm-translationKey') as HTMLInputElement,
    slug: document.getElementById('fm-slug') as HTMLInputElement,
    publishedAt: document.getElementById('fm-publishedAt') as HTMLInputElement,
    heroImage: document.getElementById('fm-heroImage') as HTMLInputElement,
    draft: document.getElementById('fm-draft') as HTMLInputElement,
  };

  // ---------- 기술 태그(tech): 체크박스 목록 + 직접입력 조합 ----------
  // 체크박스 목록은 KV에 캐시된 기존 태그들(loadTagList)로 채워지고, 거기 없는 새 태그는
  // fm-tech-extra 텍스트 입력(쉼표 구분)으로 추가한다. 최종 tech 배열은 이 둘을 합쳐서 만든다.
  function getTechValue(): string {
    const checked = Array.from(
      techCheckboxList.querySelectorAll<HTMLInputElement>('input[type="checkbox"]:checked')
    ).map((cb) => cb.value);
    const extra = techExtraInput.value
      .split(',')
      .map((t) => t.trim())
      .filter(Boolean);
    return [...new Set([...checked, ...extra])].join(', ');
  }

  function setTechValue(value: string) {
    const wanted = new Set(
      value
        .split(',')
        .map((t) => t.trim())
        .filter(Boolean)
    );
    const extras: string[] = [];
    techCheckboxList.querySelectorAll<HTMLInputElement>('input[type="checkbox"]').forEach((cb) => {
      cb.checked = wanted.has(cb.value);
      if (cb.checked) wanted.delete(cb.value);
    });
    // 체크박스 목록에 없던 값들은 extra 입력창으로
    extras.push(...wanted);
    techExtraInput.value = extras.join(', ');
  }

  function renderTechCheckboxList(tags: string[]) {
    // 갱신 시 현재 체크 상태는 보존한다 (목록 새로고침 중에도 이미 골라둔 태그가 풀리지 않도록).
    const currentlyChecked = new Set(
      Array.from(
        techCheckboxList.querySelectorAll<HTMLInputElement>('input[type="checkbox"]:checked')
      ).map((cb) => cb.value)
    );
    techCheckboxList.innerHTML = '';
    tags.forEach((tag) => {
      const label = document.createElement('label');
      const cb = document.createElement('input');
      cb.type = 'checkbox';
      cb.value = tag;
      cb.checked = currentlyChecked.has(tag);
      cb.addEventListener('change', scheduleAutosave);
      label.appendChild(cb);
      label.appendChild(document.createTextNode(tag));
      techCheckboxList.appendChild(label);
    });
  }

  async function loadTagList() {
    try {
      const res = await fetch('/api/editor/tags');
      const data = await res.json();
      renderTechCheckboxList(data.items ?? []);
    } catch {
      // 조용히 무시 - 태그 체크박스가 비어있으면 직접입력 필드로 계속 작업 가능
    }
  }

  async function refreshTagList() {
    setStatus('태그 목록 갱신 중... (기존 IT 글을 전부 훑습니다, 시간이 걸릴 수 있습니다)');
    try {
      const res = await fetch('/api/editor/tags/refresh', { method: 'POST' });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error ?? '요청 실패');
      renderTechCheckboxList(data.items ?? []);
      setStatus(`태그 목록 갱신 완료 (${data.items?.length ?? 0}개)`);
    } catch (err) {
      setStatus('태그 목록 갱신 실패: ' + (err instanceof Error ? err.message : String(err)), true);
    }
  }

  // ---------- 이미지 목록(heroImage 선택, 본문 삽입 선택) ----------
  async function loadImageList() {
    try {
      const res = await fetch('/api/editor/images');
      const data = await res.json();
      const items: string[] = data.items ?? [];
      [heroImageSelect, imgSelect].forEach((select) => {
        // 첫 번째("— 직접 입력 —") 옵션만 남기고 나머지를 새로 채운다.
        select.innerHTML = '<option value="">— 직접 입력 —</option>';
        items.forEach((name) => {
          const opt = document.createElement('option');
          opt.value = name;
          opt.textContent = name;
          select.appendChild(opt);
        });
      });
    } catch {
      // 조용히 무시 - 이미지 select가 비어있으면 직접입력 필드로 계속 작업 가능
    }
  }

  heroImageSelect.addEventListener('change', () => {
    if (heroImageSelect.value) {
      fields.heroImage.value = `/images/${heroImageSelect.value}`;
      scheduleAutosave();
    }
  });

  imgSelect.addEventListener('change', () => {
    if (imgSelect.value) {
      imgFilenameInput.value = imgSelect.value;
    }
  });

  // ---------- 로컬 파일 선택창으로 파일명 가져오기 ----------
  // 실제 업로드는 하지 않는다 (private content repo에 쓰기 권한이 없으므로).
  // 탐색기/파인더 창을 열어 파일을 고르면 그 파일의 "이름"만 가져와서 입력창에 채워준다 -
  // 관리자가 이미지를 이미 public/images/에 넣어뒀다는 전제 하에, 파일명 오타를 줄이기 위한 용도.
  imgBrowseBtn.addEventListener('click', () => imgFilePicker.click());
  imgFilePicker.addEventListener('change', () => {
    const file = imgFilePicker.files?.[0];
    if (file) {
      imgFilenameInput.value = file.name;
      imgSelect.value = '';
      // 이 파일명으로 미리보기에 blob URL을 등록해둔다 - 배포 사이트엔 아직 없는 새 이미지라도
      // 이 브라우저 안에서는 본문에 삽입했을 때 바로 미리보기에 나타나게 하기 위함.
      registerLocalImagePreview(file);
      if (previewOn) renderPreview();
      scheduleAutosave();
    }
    imgFilePicker.value = '';
  });

  heroBrowseBtn.addEventListener('click', () => heroFilePicker.click());
  heroFilePicker.addEventListener('change', () => {
    const file = heroFilePicker.files?.[0];
    if (file) {
      fields.heroImage.value = `/images/${file.name}`;
      heroImageSelect.value = '';
      registerLocalImagePreview(file);
      scheduleAutosave();
    }
    heroFilePicker.value = '';
  });

  tagsRefreshBtn.addEventListener('click', refreshTagList);
  techExtraInput.addEventListener('input', scheduleAutosave);

  function setStatus(msg: string, isError = false) {
    statusEl.textContent = msg;
    statusEl.classList.toggle('error', isError);
  }

  function updateCategoryFields() {
    const isHumanities = categorySelect.value === 'humanities';
    techWrap.hidden = isHumanities;
  }

  function resetForm() {
    fields.title.value = '';
    fields.description.value = '';
    fields.lang.value = 'ko';
    fields.translationKey.value = '';
    fields.slug.value = '';
    fields.publishedAt.value = new Date().toISOString().slice(0, 10);
    setTechValue('');
    fields.heroImage.value = '';
    heroImageSelect.value = '';
    fields.draft.checked = false;
    bodyEl.value = '';
  }

  // forceRefresh: true면 Worker의 KV 캐시(시간 만료 없음, 수동 무효화 방식)를 무시하고
  // GitHub API에서 새로 가져오게 한다(?refresh=1). content 레포에 방금 push한 글을
  // 목록에 바로 반영하고 싶을 때 "⟳ 목록 새로고침" 버튼으로 수동으로만 요청한다 -
  // 카테고리 전환처럼 자동으로 매번 호출되는 경로에서는 캐시를 그대로 쓰면 된다.
  async function loadList(forceRefresh = false) {
    setStatus('글 목록 불러오는 중...');
    try {
      const category = categorySelect.value;
      const qs = new URLSearchParams({ category });
      if (forceRefresh) qs.set('refresh', '1');
      const res = await fetch(`/api/editor/posts?${qs.toString()}`);
      const data = await res.json();
      if (!res.ok) throw new Error(data.error ?? '요청 실패');

      // /api/editor/posts 목록 응답은 이미 최신순(publishedAt 내림차순)으로 정렬되어 온다
      // (Worker 쪽에서 처리, KV 캐시). 여기서는 받은 순서 그대로 셀렉트 옵션을 채우면 된다.
      existingSelect.innerHTML = '<option value="">— 새 글 작성 —</option>';
      (data.items ?? []).forEach((item: { slug: string; title: string; publishedAt: string | null }) => {
        const opt = document.createElement('option');
        opt.value = item.slug;
        opt.textContent = item.publishedAt ? `[${item.publishedAt}] ${item.title}` : item.title;
        existingSelect.appendChild(opt);
      });
      const cacheNote = data.cached ? ' (캐시)' : '';
      setStatus(`${data.items?.length ?? 0}개 글 (ko 기준, 최신순)${cacheNote}`);
    } catch (err) {
      setStatus('목록 불러오기 실패: ' + (err instanceof Error ? err.message : String(err)), true);
    }
  }

  // 아주 단순한 frontmatter 파서. gray-matter 없이 이 페이지 안에서만 쓰는 최소 구현이라
  // 복잡한 YAML(중첩 객체 등)은 지원하지 않는다 - 이 프로젝트의 frontmatter 스키마 정도만 커버.
  function parseFrontmatter(raw: string): { fm: Record<string, string>; body: string } {
    const match = raw.match(/^---\r?\n([\s\S]*?)\r?\n---\r?\n?([\s\S]*)$/);
    if (!match) return { fm: {}, body: raw };
    const [, fmBlock, body] = match;
    const fm: Record<string, string> = {};
    fmBlock.split('\n').forEach((line) => {
      if (!line.trim() || line.trim().startsWith('#')) return;
      const idx = line.indexOf(':');
      if (idx === -1) return;
      const key = line.slice(0, idx).trim();
      let value = line.slice(idx + 1).trim();
      value = value.replace(/^["']|["']$/g, '');
      fm[key] = value;
    });
    return { fm, body: body.replace(/^\n/, '') };
  }

  async function loadExisting() {
    const slug = existingSelect.value;
    if (!slug) {
      resetForm();
      return;
    }
    setStatus('글 불러오는 중...');
    try {
      const category = categorySelect.value;
      const res = await fetch(
        `/api/editor/posts?category=${encodeURIComponent(category)}&slug=${encodeURIComponent(slug)}`
      );
      const data = await res.json();
      if (!res.ok) throw new Error(data.error ?? '요청 실패');

      applyMarkdownContent(data.content as string, slug);
      setStatus(`불러옴: ${category}/ko/${slug}.md`);
    } catch (err) {
      setStatus('글 불러오기 실패: ' + (err instanceof Error ? err.message : String(err)), true);
    }
  }

  // frontmatter가 포함된 markdown 원문(raw)을 파싱해서 폼 전체에 채워 넣는다.
  // GitHub API로 불러온 기존 글(loadExisting)과, 로컬 파일 드래그앤드롭(handleDroppedFile) 둘 다
  // 이 함수를 공유해서 쓴다 - "raw markdown → 폼 채우기" 로직은 출처와 무관하게 동일하므로.
  function applyMarkdownContent(raw: string, slugHint?: string) {
    const { fm, body } = parseFrontmatter(raw);

    // frontmatter의 category 필드로 IT/인문학 카테고리 select도 같이 맞춰준다.
    if (fm.category === 'it' || fm.category === 'humanities') {
      categorySelect.value = fm.category;
      updateCategoryFields();
    }

    fields.title.value = fm.title ?? '';
    fields.description.value = fm.description ?? '';
    fields.lang.value = fm.lang ?? 'ko';
    fields.translationKey.value = fm.translationKey ?? '';
    fields.slug.value = slugHint ?? fm.slug ?? '';
    fields.publishedAt.value = (fm.publishedAt ?? '').slice(0, 10) || new Date().toISOString().slice(0, 10);
    setTechValue((fm.tech ?? '').replace(/^\[|\]$/g, '').replace(/"/g, ''));
    fields.heroImage.value = fm.heroImage ?? '';
    heroImageSelect.value = '';
    fields.draft.checked = fm.draft === 'true';
    bodyEl.value = body;
    if (previewOn) renderPreview();
    scheduleAutosave();
  }

  // ---------- .md 파일 드래그앤드롭으로 불러오기 ----------
  // "— 새 글 작성 —" 상태(existingSelect가 비어있을 때)에서만 활성화된다.
  // 기존 글을 불러온 상태에서 실수로 다른 파일을 끌어다 놓아 덮어써버리는 사고를 막기 위함.
  // 서버 업로드는 없다 - 브라우저에서 파일을 읽기만(FileReader) 하고 끝.
  const dropOverlay = document.getElementById('ed-drop-overlay')!;

  function dropEnabled(): boolean {
    return existingSelect.value === '';
  }

  function hasFiles(e: DragEvent): boolean {
    return !!e.dataTransfer && Array.from(e.dataTransfer.types).includes('Files');
  }

  // 드롭이 끝난 직후(dropLocked) 얼마간은 dragover가 뒤늦게 한 번 더 들어와도 오버레이를
  // 다시 켜지 않도록 잠가둔다. 이전 버전은 dragover가 매번 hidden=false로 켜는 구조라,
  // drop 처리 후에도 브라우저가 dragover/dragleave를 한 번 더 발생시키는 경우
  // (파일 매니저 창의 위치, 브라우저 구현 차이 등) 오버레이가 다시 켜진 채로 안 꺼지는 문제가 있었다.
  let dropLocked = false;

  function showDropOverlay() {
    if (dropLocked) return;
    dropOverlay.hidden = false;
  }

  function hideDropOverlay() {
    dropOverlay.hidden = true;
  }

  // 안전장치: 혹시라도 오버레이가 안 사라지는 상황이 생기면 클릭이나 Esc로 강제로 닫을 수 있게.
  dropOverlay.addEventListener('click', hideDropOverlay);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') hideDropOverlay();
  });

  document.addEventListener('dragover', (e) => {
    if (!hasFiles(e) || !dropEnabled()) return;
    e.preventDefault();
    showDropOverlay();
  });

  document.addEventListener('dragleave', (e) => {
    if (!hasFiles(e)) return;
    // 브라우저 창 자체를 벗어난 경우에만 숨김 (relatedTarget이 null이거나 문서 밖)
    if (!e.relatedTarget || (e.relatedTarget as Node).nodeName === undefined) {
      hideDropOverlay();
    }
  });

  document.addEventListener('dragend', () => {
    hideDropOverlay();
  });

  document.addEventListener('drop', (e) => {
    e.preventDefault();
    // 잠깐(0.5초) 오버레이 재표시를 막아 뒤늦은 dragover 이벤트로 다시 켜지는 걸 방지.
    dropLocked = true;
    hideDropOverlay();
    setTimeout(() => {
      dropLocked = false;
    }, 500);

    if (!hasFiles(e)) return;

    if (!dropEnabled()) {
      setStatus('기존 글을 불러온 상태에서는 드래그앤드롭이 비활성화됩니다. "— 새 글 작성 —"으로 전환한 뒤 다시 시도하세요.', true);
      return;
    }

    const file = e.dataTransfer?.files?.[0];
    if (!file) return;
    const lowerName = file.name.toLowerCase();
    if (!lowerName.endsWith('.md') && !lowerName.endsWith('.mdx')) {
      setStatus('마크다운(.md, .mdx) 파일만 드래그앤드롭으로 불러올 수 있습니다.', true);
      return;
    }

    const reader = new FileReader();
    reader.onload = () => {
      const text = String(reader.result ?? '');
      const slugHint = file.name.replace(/\.mdx?$/i, '');
      applyMarkdownContent(text, slugHint);
      setStatus(`파일 불러옴: ${file.name}`);
    };
    reader.onerror = () => {
      setStatus('파일을 읽지 못했습니다.', true);
    };
    reader.readAsText(file);
  });

  function buildMarkdown(): string {
    const category = categorySelect.value;
    const lines = ['---'];
    lines.push(`title: "${fields.title.value.replace(/"/g, '\\"')}"`);
    lines.push(`description: "${fields.description.value.replace(/"/g, '\\"')}"`);
    lines.push(`lang: ${fields.lang.value}`);
    lines.push(`translationKey: "${fields.translationKey.value}"`);
    lines.push(`publishedAt: ${fields.publishedAt.value}`);
    lines.push(`draft: ${fields.draft.checked}`);
    lines.push(`category: ${category}`);
    if (category === 'it') {
      const tech = getTechValue()
        .split(',')
        .map((t) => t.trim())
        .filter(Boolean);
      lines.push(`tech: [${tech.join(', ')}]`);
    } else {
      // 소분류 UI는 제거됨(추후 태그 방식으로 통합 예정) - 프론트매터 스키마 호환을 위해 고정값만 채움.
      lines.push(`subcategory: review`);
    }
    if (fields.heroImage.value.trim()) {
      lines.push(`heroImage: "${fields.heroImage.value.trim()}"`);
    }
    lines.push('---');
    lines.push('');
    lines.push(bodyEl.value);
    return lines.join('\n');
  }

  function download() {
    if (!fields.title.value || !fields.slug.value || !fields.translationKey.value) {
      setStatus('제목, slug, translationKey는 필수입니다.', true);
      return;
    }
    const markdown = buildMarkdown();
    // <PostCard .../>를 쓴 글은 Astro 컴포넌트를 해석할 수 있는 .mdx로 저장해야
    // 실제 사이트에서 카드가 렌더링된다(.md는 순수 텍스트라 이 태그가 그대로 노출됨).
    // PostCard 없이 쓴 글은 지금까지처럼 .md 그대로 - 기존 글 전부를 mdx로 바꿀 필요 없음.
    const usesPostCard = POST_CARD_RE.test(markdown);
    POST_CARD_RE.lastIndex = 0; // test()가 옮겨놓은 전역 정규식 커서 되돌리기 (다음 검사에 영향 안 주게)
    const ext = usesPostCard ? 'mdx' : 'md';
    const blob = new Blob([markdown], { type: 'text/markdown;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `${fields.slug.value}.${ext}`;
    document.body.appendChild(a);
    a.click();
    a.remove();
    URL.revokeObjectURL(url);

    const category = categorySelect.value;
    setStatus(
      `다운로드 완료. content/${category}/${fields.lang.value}/${fields.slug.value}.${ext} 로 옮기고 git commit/push 하세요.` +
        (usesPostCard ? ' (PostCard 사용 - .mdx로 저장됨)' : '')
    );
  }

  // ---------- 서식 툴바 (굵게/기울임/링크/이미지) ----------
  //
  // textarea.value를 직접 덮어쓰면(bodyEl.value = ...) 브라우저의 undo 스택에 그 변경이
  // 기록되지 않는다 - 즉 서식 버튼/단축키를 쓴 뒤 Ctrl+Z를 눌러도 되돌려지지 않는 문제가
  // 있었다. document.execCommand('insertText', ...)는 deprecated API지만, "지금 선택된
  // 구간을 주어진 텍스트로 치환"하는 동작을 여전히 모든 주요 브라우저가 지원하고, 이 방식은
  // 네이티브 입력으로 취급되어 undo 스택에 정상적으로 쌓인다 - 그래서 값을 직접 대입하는 대신
  // "바꿀 구간을 setSelectionRange로 먼저 선택 → execCommand로 그 구간만 치환"하는 방식을
  // 쓴다. execCommand가 없는 아주 오래된/특수한 환경을 위해 실패하면 기존 방식(직접 대입)으로
  // 폴백하되, 그 경우엔 undo가 안 될 수 있음을 감수한다.
  function replaceRange(start: number, end: number, text: string) {
    bodyEl.focus();
    bodyEl.setSelectionRange(start, end);
    const ok = document.execCommand && document.execCommand('insertText', false, text);
    if (!ok) {
      // 폴백: execCommand를 못 쓰는 환경 - undo는 깨지지만 최소한 동작은 하게.
      bodyEl.value = bodyEl.value.slice(0, start) + text + bodyEl.value.slice(end);
      bodyEl.setSelectionRange(start + text.length, start + text.length);
    }
    scheduleAutosave();
  }

  // textarea의 현재 선택 영역을 감싸거나, 선택이 없으면 플레이스홀더 템플릿을 커서 위치에 삽입한다.
  function wrapSelection(before: string, after: string, placeholder: string) {
    const start = bodyEl.selectionStart;
    const end = bodyEl.selectionEnd;
    const selected = bodyEl.value.slice(start, end) || placeholder;
    replaceRange(start, end, before + selected + after);
    const cursorStart = start + before.length;
    const cursorEnd = cursorStart + selected.length;
    bodyEl.setSelectionRange(cursorStart, cursorEnd);
  }

  function insertAtCursor(text: string) {
    const start = bodyEl.selectionStart;
    const end = bodyEl.selectionEnd;
    replaceRange(start, end, text);
    const pos = start + text.length;
    bodyEl.setSelectionRange(pos, pos);
  }

  boldBtn.addEventListener('click', () => wrapSelection('**', '**', '굵은 텍스트'));
  italicBtn.addEventListener('click', () => wrapSelection('*', '*', '기울임 텍스트'));
  underlineBtn.addEventListener('click', () => wrapSelection('<u>', '</u>', '밑줄 텍스트'));
  strikeBtn.addEventListener('click', () => wrapSelection('~~', '~~', '취소선 텍스트'));
  linkBtn.addEventListener('click', () => {
    const start = bodyEl.selectionStart;
    const end = bodyEl.selectionEnd;
    const selected = bodyEl.value.slice(start, end);
    if (selected) {
      wrapSelection('[', '](url)', selected);
    } else {
      insertAtCursor('[링크 텍스트](url)');
    }
  });
  imageBtn.addEventListener('click', () => insertAtCursor('![설명](/images/파일명.jpg)'));

  // ---------- 서식 단축키 (textarea에 포커스된 상태에서만 동작) ----------
  // Ctrl+B 굵게 / Ctrl+I 기울임 / Ctrl+U 밑줄 / Ctrl+Shift+S 취소선
  // 브라우저 기본 동작(예: Ctrl+B 즐겨찾기바, Ctrl+U 소스보기)을 막기 위해 preventDefault 필수.
  // macOS 사용자를 위해 metaKey(⌘)도 함께 허용.
  bodyEl.addEventListener('keydown', (e) => {
    const mod = e.ctrlKey || e.metaKey;
    if (!mod) return;
    const key = e.key.toLowerCase();
    if (key === 'b') {
      e.preventDefault();
      wrapSelection('**', '**', '굵은 텍스트');
    } else if (key === 'i') {
      e.preventDefault();
      wrapSelection('*', '*', '기울임 텍스트');
    } else if (key === 'u') {
      e.preventDefault();
      wrapSelection('<u>', '</u>', '밑줄 텍스트');
    } else if (key === 's' && e.shiftKey) {
      e.preventDefault();
      wrapSelection('~~', '~~', '취소선 텍스트');
    }
  });

  // ---------- Tab / Shift+Tab 들여쓰기 (마크다운 리스트 중첩용) ----------
  // 마크다운 리스트 하위 항목은 공백 4칸 들여쓰기가 정석(탭 문자는 렌더러마다 해석이 달라
  // 깨질 수 있어 피함). textarea 기본 동작(Tab = 다음 요소로 포커스 이동)을 막고 대신
  // 커서 위치에 공백 4칸을 넣거나(Tab), 현재 줄 맨 앞의 들여쓰기를 최대 4칸 제거한다(Shift+Tab).
  // 여러 줄이 선택된 상태면 선택된 모든 줄에 한꺼번에 적용된다(일반 코드 에디터와 동일한 동작).
  const INDENT = '    '; // 공백 4칸

  bodyEl.addEventListener('keydown', (e) => {
    if (e.key !== 'Tab') return;
    e.preventDefault();

    const start = bodyEl.selectionStart;
    const end = bodyEl.selectionEnd;
    const value = bodyEl.value;

    // 선택 영역이 걸쳐있는 줄들의 시작/끝 인덱스를 구한다.
    const lineStart = value.lastIndexOf('\n', start - 1) + 1;
    let lineEnd = value.indexOf('\n', end);
    if (lineEnd === -1) lineEnd = value.length;

    const selectedLines = value.slice(lineStart, lineEnd);
    const isMultiLine = selectedLines.includes('\n');

    if (!e.shiftKey) {
      // Tab: 들여쓰기
      if (!isMultiLine && start === end) {
        // 선택 없이 커서만 있는 단일 줄 - 커서 위치에 공백 4칸만 삽입.
        insertAtCursor(INDENT);
        return;
      }
      const indented = selectedLines
        .split('\n')
        .map((line) => INDENT + line)
        .join('\n');
      replaceRange(lineStart, lineEnd, indented);
      bodyEl.setSelectionRange(start + INDENT.length, end + INDENT.length * indented.split('\n').length);
      if (previewOn) renderPreview();
    } else {
      // Shift+Tab: 내어쓰기 - 각 줄 맨 앞의 공백을 최대 4칸(또는 탭 1개)만큼 제거.
      let removedFromFirstLine = 0;
      let totalRemoved = 0;
      const outdented = selectedLines
        .split('\n')
        .map((line, i) => {
          let removeCount = 0;
          if (line.startsWith(INDENT)) removeCount = INDENT.length;
          else if (line.startsWith('\t')) removeCount = 1;
          else {
            // 4칸 미만이면 있는 만큼만(앞부분 공백만) 제거.
            const leadingSpaces = line.match(/^ */)?.[0].length ?? 0;
            removeCount = Math.min(leadingSpaces, INDENT.length);
          }
          if (i === 0) removedFromFirstLine = removeCount;
          totalRemoved += removeCount;
          return line.slice(removeCount);
        })
        .join('\n');
      replaceRange(lineStart, lineEnd, outdented);
      const newStart = Math.max(lineStart, start - removedFromFirstLine);
      const newEnd = Math.max(newStart, end - totalRemoved);
      bodyEl.setSelectionRange(newStart, newEnd);
      if (previewOn) renderPreview();
    }
  });

  // ---------- Shift+. (>) 인용문(blockquote) 토글 ----------
  // 미국 자판 기준 Shift+.는 ">" 문자다(e.key가 이미 ">"로 들어옴). 선택된 여러 줄
  // 각각의 맨 앞에 "> "를 붙인다(Tab 들여쓰기와 동일한 방식으로 줄 단위 처리).
  // 이미 전부 "> "로 시작하는 줄들이면 토글처럼 다시 벗겨낸다(같은 단축키를 두 번
  // 누르면 원상복구되는 게 자연스러워서). 빈 줄도 예외 없이 포함해서 "> "를 붙인다 -
  // 인용문 블록 중간에 빈 줄이 껴 있으면 마크다운이 그 지점에서 인용문이 끊긴다고
  // 해석하므로, 여러 문단짜리 인용문을 한 블록으로 유지하려면 빈 줄도 "> "로 채워야 한다.
  bodyEl.addEventListener('keydown', (e) => {
    if (e.key !== '>' || !e.shiftKey) return;
    e.preventDefault();

    const start = bodyEl.selectionStart;
    const end = bodyEl.selectionEnd;
    const value = bodyEl.value;

    const lineStart = value.lastIndexOf('\n', start - 1) + 1;
    let lineEnd = value.indexOf('\n', end);
    if (lineEnd === -1) lineEnd = value.length;

    const selectedLines = value.slice(lineStart, lineEnd);
    const lines = selectedLines.split('\n');
    const allQuoted = lines.every((line) => line.startsWith('>'));

    let delta = 0; // 줄 수가 아니라 "문자 수" 변화 - 선택 영역 보정에 씀
    let deltaFirstLine = 0;

    const transformed = lines
      .map((line, i) => {
        if (allQuoted) {
          // 이미 인용된 상태 - "> " 또는 (빈 줄이었던 경우) ">"만 제거
          const removed = line.startsWith('> ') ? 2 : line.startsWith('>') ? 1 : 0;
          if (i === 0) deltaFirstLine = -removed;
          delta -= removed;
          return line.slice(removed);
        }
        // 빈 줄 포함 모든 줄에 "> "를 붙인다.
        if (i === 0) deltaFirstLine = 2;
        delta += 2;
        return '> ' + line;
      })
      .join('\n');

    replaceRange(lineStart, lineEnd, transformed);
    const newStart = Math.max(lineStart, start + deltaFirstLine);
    const newEnd = Math.max(newStart, end + delta);
    bodyEl.setSelectionRange(newStart, newEnd);
    if (previewOn) renderPreview();
  });

  // ---------- 이미지 파일명 삽입 도우미 ----------
  // 실제 이미지 파일 업로드 기능은 없다 (private content repo에 쓰기 권한이 없으므로).
  // 관리자가 이미지를 미리 content 저장소의 public/images/ 에 직접 넣어둔 뒤,
  // 여기서는 그 파일명으로 올바른 형식의 ![]() 마크다운 태그만 커서 위치에 삽입해준다.
  imgInsertBtn.addEventListener('click', () => {
    const filename = imgFilenameInput.value.trim();
    if (!filename) {
      setStatus('이미지 파일명을 입력하세요.', true);
      return;
    }
    const alt = imgAltInput.value.trim() || filename;
    const path = filename.startsWith('/') ? filename : `/images/${filename}`;
    insertAtCursor(`![${alt}](${path})`);
    setStatus(`이미지 태그 삽입됨: ${path}`);
    imgAltInput.value = '';
    imgFilenameInput.value = '';
    imgSelect.value = '';
  });

  // ---------- 로컬 이미지 미리보기 (배포된 사이트/public/images/엔 아직 없는 새 이미지도
  // 에디터 미리보기에서만큼은 보이게 하기 위한 기능) ----------
  // 실제 업로드는 여전히 하지 않는다 - 선택한 이미지 파일을 브라우저 메모리 안에서만
  // Blob URL로 바꿔서 <img>의 src를 그 순간만 가리키게 할 뿐, 다운로드되는 .md 파일에는
  // 항상 원래의 /images/파일명.ext 경로가 그대로 저장된다 (배포 후 실제 경로와 일치해야 하므로).
  // 파일명(예: photo1.jpg) 기준으로 매칭하기 때문에, heroImage든 본문 삽입 이미지든
  // 같은 파일명을 쓰면 같은 로컬 미리보기가 적용된다.
  const localImagePreviews = new Map<string, string>(); // 파일명 -> blob: URL

  function registerLocalImagePreview(file: File) {
    // 같은 파일명으로 이전에 등록해둔 blob URL이 있다면 메모리 누수 방지를 위해 해제하고 교체.
    const prev = localImagePreviews.get(file.name);
    if (prev) URL.revokeObjectURL(prev);
    localImagePreviews.set(file.name, URL.createObjectURL(file));
  }

  // ---------- public/images 폴더 연결 (File System Access API) ----------
  // 파일 선택창으로 이미지를 하나하나 고르지 않아도, public/images 폴더 자체를 한 번
  // 연결해두면 본문에 등장하는 이미지 파일명을 그 폴더에서 자동으로 찾아 미리보기에 걸어준다.
  // 특히 .md 드래그앤드롭으로 기존 작성 중이던 글을 불러올 때 유용함 - 파일 자체는
  // 안 딸려오지만, 본문에 이미 적힌 파일명들로 로컬 폴더를 뒤져서 채워줄 수 있음.
  // Chrome/Edge 등 File System Access API 지원 브라우저에서만 동작하며, 지원 안 하면
  // 버튼이 조용히 비활성화된다. 폴더 접근 권한은 이 탭에서만 유효하고 서버로는 전혀 전송되지 않는다.
  // File System Access API 타입은 TS lib에 아직 표준으로 포함되지 않은 경우가 있어 any로 느슨하게 처리.
  //
  // mode: 'readwrite' - 예전엔 'read'(읽기 전용)였다. 이 에디터는 원래 "실제 업로드는
  // 하지 않는다"는 설계였는데(private content repo에 서버가 직접 쓸 방법이 없어서), 클립보드
  // 스크린샷 붙여넣기(아래 paste 핸들러)는 이미지를 실제로 폴더에 써야 의미가 있는 기능이라
  // 여기서만 쓰기 권한을 올렸다. 그래도 브라우저가 매번 "이 폴더에 쓰기를 허용할지" 별도로
  // 한 번 더 물어보므로(File System Access API 표준 동작), 조용히 파일이 써지는 일은 없다.
  let imagesDirHandle: any = null;
  const connectImagesBtn = document.getElementById('ed-connect-images')!;

  if (!('showDirectoryPicker' in window)) {
    connectImagesBtn.setAttribute('disabled', 'true');
    connectImagesBtn.title = '이 브라우저는 폴더 연결 기능을 지원하지 않습니다 (Chrome/Edge 등에서 사용 가능)';
  }

  connectImagesBtn.addEventListener('click', async () => {
    try {
      imagesDirHandle = await (window as any).showDirectoryPicker({ id: 'deaf52-editor-images', mode: 'readwrite' });
      connectImagesBtn.textContent = `🖼 연결됨: ${imagesDirHandle!.name}`;
      setStatus(`이미지 폴더 연결됨: ${imagesDirHandle!.name} (붙여넣기로 스크린샷 저장 가능)`);
      if (previewOn) renderPreview();
    } catch {
      // 사용자가 폴더 선택을 취소한 경우 등 - 조용히 무시
    }
  });

  // ---------- 본문에 스크린샷 붙여넣기(Ctrl+V) ----------
  // 이미지 폴더가 연결(readwrite)된 상태에서 클립보드에 이미지가 있으면, 그 이미지를
  // "{slug}-{일련번호}.png"라는 이름으로 실제로 그 폴더에 저장하고, 커서 위치에
  // 마크다운 이미지 문법(![](/images/파일명))을 자동 삽입한다. 매번 파일명을 직접
  // 타이핑하고 별도로 이미지를 폴더에 옮겨야 했던 수작업을 붙여넣기 한 번으로 줄인다.
  //
  // 일련번호는 "그 글(slug)의 이미지가 몇 개 있는지"를 기준으로 정한다 - 폴더 안에서
  // 같은 slug로 시작하는 파일(slug-01.png, slug-02.jpg 등)의 개수를 세어 다음 번호를
  // 매긴다. 전역 카운터가 아니라 매번 폴더를 다시 세는 이유는, 같은 세션에서 다른 글로
  // 전환하거나 폴더가 이미 이전에 채워져 있던 경우에도 항상 실제 폴더 상태와 번호가
  // 어긋나지 않게 하기 위함(메모리에 카운터를 따로 들고 있으면 새로고침/전환 시 리셋되거나
  // 실제 폴더 상태와 엇나갈 수 있음).
  function pasteImageFilenamePattern(slug: string): RegExp {
    const escapedSlug = slug.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    return new RegExp(`^${escapedSlug}-(\\d+)\\.[a-zA-Z0-9]+$`);
  }

  async function nextPasteImageIndex(slug: string): Promise<number> {
    if (!imagesDirHandle) return 1;
    const re = pasteImageFilenamePattern(slug);
    let maxIndex = 0;
    try {
      for await (const [name] of imagesDirHandle.entries()) {
        const m = name.match(re);
        if (m) maxIndex = Math.max(maxIndex, parseInt(m[1], 10));
      }
    } catch {
      // 폴더 목록을 못 읽으면(권한 문제 등) 1번부터 시작 - 최선의 추정치로 폴백.
    }
    return maxIndex + 1;
  }

  function extForMimeType(mimeType: string): string {
    if (mimeType === 'image/png') return 'png';
    if (mimeType === 'image/jpeg') return 'jpg';
    if (mimeType === 'image/webp') return 'webp';
    if (mimeType === 'image/gif') return 'gif';
    return 'png'; // 스크린샷 도구는 대부분 png를 클립보드에 넣으므로 안전한 기본값
  }

  bodyEl.addEventListener('paste', async (e: ClipboardEvent) => {
    const items = e.clipboardData?.items;
    if (!items) return;
    const imageItem = Array.from(items).find((item) => item.type.startsWith('image/'));
    if (!imageItem) return; // 이미지가 아니면(일반 텍스트 붙여넣기 등) 기본 동작 그대로 둔다.

    // 여기서부터는 이미지 붙여넣기로 처리하겠다는 뜻이므로, textarea의 기본 붙여넣기
    // (파일 경로 텍스트가 그대로 붙는 등 브라우저마다 다른 동작)를 막는다.
    e.preventDefault();

    if (!imagesDirHandle) {
      setStatus('이미지를 저장할 폴더가 연결되어 있지 않습니다. "🖼 이미지 폴더 연결"을 먼저 눌러주세요.', true);
      return;
    }
    const slug = fields.slug.value.trim();
    if (!slug) {
      setStatus('먼저 slug를 입력해야 붙여넣은 이미지의 파일명을 정할 수 있습니다.', true);
      return;
    }

    const file = imageItem.getAsFile();
    if (!file) return;

    setStatus('스크린샷 저장 중...');
    try {
      const index = await nextPasteImageIndex(slug);
      const ext = extForMimeType(file.type);
      const filename = `${slug}-${String(index).padStart(2, '0')}.${ext}`;

      const fileHandle = await imagesDirHandle.getFileHandle(filename, { create: true });
      const writable = await fileHandle.createWritable();
      await writable.write(file);
      await writable.close();

      // 실제로 방금 저장한 파일이니 바로 미리보기에도 등록 - registerLocalImagePreview는
      // File 객체만 필요하므로 클립보드에서 받은 file을 그대로 재사용한다.
      registerLocalImagePreview(file);

      const { selectionStart, selectionEnd } = bodyEl;
      replaceRange(selectionStart, selectionEnd, `![](/images/${filename})`);
      if (previewOn) renderPreview();
      setStatus(`스크린샷 저장됨: ${filename}`);
    } catch (err) {
      setStatus('스크린샷 저장 실패: ' + (err instanceof Error ? err.message : String(err)), true);
    }
  });

  // ---------- PostCard 미리보기용 content 레포 폴더 연결 (로컬 dev용) ----------
  // /api/editor/posts는 Cloudflare Worker가 처리하는데, `npm run dev`(순수 Astro dev
  // 서버)에는 이 Worker 라우트가 없어서 로컬에서는 PostCard 미리보기가 항상
  // "불러오는 중 또는 없음"으로만 보인다. 이미지 폴더 연결과 같은 방식(File System
  // Access API)으로 content 레포의 최상위 폴더(it/, humanities/가 있는 곳)를 연결해두면,
  // API 대신 로컬 파일을 직접 읽어 frontmatter의 title/description을 파싱해서 보여준다.
  let contentDirHandle: any = null;
  const connectContentBtn = document.getElementById('ed-connect-content')!;

  if (!('showDirectoryPicker' in window)) {
    connectContentBtn.setAttribute('disabled', 'true');
    connectContentBtn.title = '이 브라우저는 폴더 연결 기능을 지원하지 않습니다 (Chrome/Edge 등에서 사용 가능)';
  }

  connectContentBtn.addEventListener('click', async () => {
    try {
      contentDirHandle = await (window as any).showDirectoryPicker({ id: 'deaf52-editor-content', mode: 'read' });
      connectContentBtn.textContent = `🔖 연결됨: ${contentDirHandle!.name}`;
      setStatus(`콘텐츠 폴더 연결됨: ${contentDirHandle!.name}`);
      postCardMetaCache.clear(); // 폴더가 새로 연결됐으니 이전에 "없음"으로 캐싱된 것도 다시 찾아보게 초기화
      if (previewOn) renderPreview();
    } catch {
      // 취소 등 - 조용히 무시
    }
  });

  // content 레포 폴더에서 {category}/ko/{slug}.md 또는 .mdx를 찾아 frontmatter를 파싱.
  // 못 찾으면 null(이후 API 조회로 폴백).
  async function tryResolvePostCardFromContentDir(
    category: string,
    slug: string
  ): Promise<PostCardMeta | null> {
    if (!contentDirHandle) return null;
    try {
      const categoryDir = await contentDirHandle.getDirectoryHandle(category);
      const koDir = await categoryDir.getDirectoryHandle('ko');
      let file: File | null = null;
      for (const ext of ['md', 'mdx']) {
        try {
          const fileHandle = await koDir.getFileHandle(`${slug}.${ext}`);
          file = await fileHandle.getFile();
          break;
        } catch {
          // 이 확장자로는 없음 - 다음 확장자 시도
        }
      }
      if (!file) return null;
      const text = await file.text();
      return {
        title: parseFrontmatterField(text, 'title') || slug,
        description: parseFrontmatterField(text, 'description'),
        heroImage: parseFrontmatterField(text, 'heroImage'),
      };
    } catch {
      return null;
    }
  }

  // 폴더에서 파일명으로 이미지를 찾아 blob URL로 등록한다 (한 번 찾은 파일은 localImagePreviews에
  // 캐시되어 재탐색하지 않는다). 못 찾으면 false를 반환.
  async function tryResolveFromImagesDir(filename: string): Promise<boolean> {
    if (!imagesDirHandle || localImagePreviews.has(filename)) return localImagePreviews.has(filename);
    try {
      const fileHandle = await imagesDirHandle.getFileHandle(filename);
      const file = await fileHandle.getFile();
      registerLocalImagePreview(file);
      return true;
    } catch {
      return false;
    }
  }

  // ---------- 미리보기 (기본 표시, 데스크탑에서는 본문 옆에 항상 실시간으로 보여줌) ----------
  // 데스크탑 위주로 쓰기 때문에 오른쪽에 상시 표시하는 쪽이 더 편하다고 판단해 기본값을 켬으로 바꿈.
  // 화면이 좁아지면(CSS 미디어쿼리) 어차피 세로로 쌓이므로, 필요하면 토글 버튼으로 숨겨서
  // textarea 공간을 넓게 쓸 수 있게 남겨둔다.
  let previewOn = true;
  let previewRenderSeq = 0; // 연속 입력 중 비동기 렌더링이 뒤섞여 오래된 결과로 덮어쓰는 것을 방지

  // ---------- <PostCard /> 미리보기 ----------
  // 실제 사이트는 MDX(<PostCard slug="..." category="it" />)를 Astro 컴포넌트로
  // 렌더링하지만, 여기 미리보기는 marked.js라 JSX/Astro 컴포넌트를 이해하지 못한다.
  // 그래서 marked에 넘기기 전에 정규식으로 이 태그를 감지해서, 실제 PostCard.astro와
  // 최대한 비슷한 카드 HTML로 직접 치환한다(완전히 동일하진 않지만 근사 미리보기 - 표
  // 좌측 제목열 처리와 같은 관례). 카드에 넣을 title/description은 기존
  // /api/editor/posts?category=xxx&slug=yyy(ko 원본 조회 API)를 재사용해서 가져오고,
  // 한 번 찾은 건 postCardMetaCache에 캐싱해 매 입력마다 다시 요청하지 않는다.
  const POST_CARD_RE = /<PostCard\s+slug=["']([^"']+)["']\s+category=["'](it|humanities)["']\s*\/?>/g;
  type PostCardMeta = { title: string; description: string; heroImage: string };
  const postCardMetaCache = new Map<string, PostCardMeta | null>();
  // 실제 사이트(PostCard.astro)의 도메인 표시와 동일하게 맞추기 위한 값.
  // site.config.ts를 여기서 import하진 않고(이 스크립트는 순수 클라이언트 JS라
  // 서버 전용 모듈을 끌어오면 배보다 배꼽이 큼) 값만 그대로 복사해둔다 -
  // site.config.ts의 siteUrl이 바뀌면 이 줄도 같이 바꿔줘야 함.
  const PREVIEW_DOMAIN = 'deaf52.dev';

  function parseFrontmatterField(raw: string, field: string): string {
    const line = raw.split('\n').find((l) => l.startsWith(`${field}:`));
    if (!line) return '';
    return line
      .slice(field.length + 1)
      .trim()
      .replace(/^["']|["']$/g, '');
  }

  async function fetchPostCardMeta(category: string, slug: string) {
    const cacheKey = `${category}/${slug}`;
    if (postCardMetaCache.has(cacheKey)) return postCardMetaCache.get(cacheKey) ?? null;

    // 1순위: 로컬에 연결해둔 content 폴더 (API 없이 즉시 동작, 로컬 dev 서버에서 특히 유용)
    const fromLocal = await tryResolvePostCardFromContentDir(category, slug);
    if (fromLocal) {
      postCardMetaCache.set(cacheKey, fromLocal);
      return fromLocal;
    }

    // 2순위: Worker API (배포 환경, 또는 wrangler dev로 로컬에서 Worker까지 띄운 경우 동작)
    try {
      const res = await fetch(`/api/editor/posts?category=${category}&slug=${encodeURIComponent(slug)}`);
      if (!res.ok) throw new Error('not found');
      const data = await res.json();
      const meta: PostCardMeta = {
        title: parseFrontmatterField(data.content, 'title') || slug,
        description: parseFrontmatterField(data.content, 'description'),
        heroImage: parseFrontmatterField(data.content, 'heroImage'),
      };
      postCardMetaCache.set(cacheKey, meta);
      return meta;
    } catch {
      postCardMetaCache.set(cacheKey, null);
      return null;
    }
  }

  function postCardHtml(category: string, slug: string, meta: PostCardMeta | null): string {
    if (!meta) {
      // 아직 못 찾았거나(로딩 중) 존재하지 않는 slug - 자리표시자만 보여준다.
      return `<div class="post-card-placeholder">🔖 PostCard: ${category}/${slug} (불러오는 중 또는 없음)</div>`;
    }
    const thumb = meta.heroImage
      ? `<img class="post-card-thumb" src="${meta.heroImage}" alt="" />`
      : '';
    return (
      `<a class="post-card" href="#" onclick="return false;">` +
      thumb +
      `<span class="post-card-body">` +
      `<span class="post-card-title">${meta.title}</span>` +
      `<span class="post-card-desc">${meta.description}</span>` +
      `<span class="post-card-domain">${PREVIEW_DOMAIN}</span>` +
      `</span>` +
      `<span class="post-card-arrow" aria-hidden="true">→</span>` +
      `</a>`
    );
  }

  // ---------- 북마크 카드 삽입 모달 ----------
  // 🔖 버튼을 누르거나, 본문에 "/북마크"라고 타이핑하면 열린다. it/humanities 두
  // 카테고리의 글 목록을 한 번에 모아 보여주고, 검색어로 제목/slug를 필터링한다.
  // 선택하면 커서 위치(또는 "/북마크" 문자열이 있던 자리)에
  // <PostCard slug="..." category="..." /> 를 그대로 삽입한다.
  type BookmarkCandidate = { category: 'it' | 'humanities'; slug: string; title: string };

  let bookmarkCandidates: BookmarkCandidate[] = [];
  let bookmarkCandidatesLoaded = false;
  // "/북마크" 타이핑으로 열렸을 때는, 선택 시 그 문자열 자리를 지우고 카드로 바꿔야 하므로
  // 그 위치를 기억해둔다. 🔖 버튼으로 열었을 때는 null(현재 커서 위치에 그냥 삽입).
  let bookmarkTriggerRange: { start: number; end: number } | null = null;

  // 글 목록(slug+title)을 한 번만 모아두고 캐싱 - 검색할 때마다 다시 안 불러옴.
  //
  // 예전엔 여기서 slug 목록만 받은 뒤, 제목을 보여주려고 글마다 fetchPostCardMeta()를
  // 순차 호출했다(카테고리당 글 수만큼 GitHub API 요청을 하나씩 기다림 - N+1 문제).
  // 글이 늘어날수록 모달을 열 때마다 점점 느려졌다. 이제 /api/editor/posts가
  // 목록 응답에 title까지 같이 내려주므로(Worker 쪽에서 서버 사이드로 병렬 처리),
  // 여기서는 그 결과를 그대로 쓰면 되고 글 수만큼 반복 호출할 필요가 없다.
  // (카드 썸네일/설명까지 필요한 렌더링 시점에는 fetchPostCardMeta를 여전히 쓰지만,
  // 그건 선택된 글 하나에 대해서만 호출되므로 N+1이 아니다.)
  async function loadBookmarkCandidates(): Promise<BookmarkCandidate[]> {
    if (bookmarkCandidatesLoaded) return bookmarkCandidates;
    bookmarkListEl.innerHTML = '<p class="editor-modal-empty">글 목록 불러오는 중...</p>';

    const categories: Array<'it' | 'humanities'> = ['it', 'humanities'];
    const results: BookmarkCandidate[] = [];

    for (const category of categories) {
      try {
        const res = await fetch(`/api/editor/posts?category=${category}`);
        const data = await res.json();
        const items: Array<{ slug: string; title: string }> = data.items ?? [];
        // 이미 최신순으로 온 items 순서를 그대로 유지 - 카테고리별로 최신 글이 위에 오게 됨.
        for (const item of items) {
          results.push({ category, slug: item.slug, title: item.title });
        }
      } catch {
        // 이 카테고리 목록을 못 가져와도 다른 카테고리는 계속 진행
      }
    }

    bookmarkCandidates = results;
    bookmarkCandidatesLoaded = true;
    return results;
  }

  function renderBookmarkList(filterText: string) {
    const q = filterText.trim().toLowerCase();
    const filtered = q
      ? bookmarkCandidates.filter(
          (c) => c.title.toLowerCase().includes(q) || c.slug.toLowerCase().includes(q)
        )
      : bookmarkCandidates;

    if (filtered.length === 0) {
      bookmarkListEl.innerHTML = '<p class="editor-modal-empty">일치하는 글이 없습니다.</p>';
      return;
    }

    bookmarkListEl.innerHTML = '';
    filtered.forEach((c) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'editor-modal-item';
      btn.innerHTML =
        `<span class="editor-modal-item-title">${c.title}</span>` +
        `<span class="editor-modal-item-meta">${c.category}/${c.slug}</span>`;
      btn.addEventListener('click', () => insertBookmark(c));
      bookmarkListEl.appendChild(btn);
    });
  }

  function insertBookmark(candidate: BookmarkCandidate) {
    const tag = `<PostCard slug="${candidate.slug}" category="${candidate.category}" />`;
    const value = bodyEl.value;

    if (bookmarkTriggerRange) {
      // "/북마크" 문자열을 지우고 그 자리에 삽입
      const { start, end } = bookmarkTriggerRange;
      replaceRange(start, end, tag);
      const caret = start + tag.length;
      bodyEl.setSelectionRange(caret, caret);
    } else {
      // 🔖 버튼으로 열었을 때는 현재 커서 위치에 삽입
      const start = bodyEl.selectionStart ?? value.length;
      const end = bodyEl.selectionEnd ?? value.length;
      replaceRange(start, end, tag);
      const caret = start + tag.length;
      bodyEl.setSelectionRange(caret, caret);
    }

    closeBookmarkModal();
    bodyEl.focus();
    if (previewOn) renderPreview();
  }

  async function openBookmarkModal(triggerRange: { start: number; end: number } | null) {
    bookmarkTriggerRange = triggerRange;
    bookmarkModal.hidden = false;
    bookmarkSearchInput.value = '';
    await loadBookmarkCandidates();
    renderBookmarkList('');
    bookmarkSearchInput.focus();
  }

  function closeBookmarkModal() {
    bookmarkModal.hidden = true;
    bookmarkTriggerRange = null;
  }

  bookmarkBtn.addEventListener('click', () => openBookmarkModal(null));
  bookmarkCloseBtn.addEventListener('click', closeBookmarkModal);
  bookmarkModal.addEventListener('click', (e) => {
    if (e.target === bookmarkModal) closeBookmarkModal(); // 바깥(어두운 배경) 클릭 시 닫기
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !bookmarkModal.hidden) closeBookmarkModal();
  });
  bookmarkSearchInput.addEventListener('input', () => renderBookmarkList(bookmarkSearchInput.value));

  // 본문에 "/북마크"를 입력하면 자동으로 모달을 연다. 커서 바로 앞 4글자만 검사하므로
  // 가볍고, 다른 슬래시 명령이나 URL(예: "https://...")과 헷갈릴 일이 없다.
  const BOOKMARK_TRIGGER = '/북마크';
  bodyEl.addEventListener('input', () => {
    if (!bookmarkModal.hidden) return; // 이미 열려 있으면 중복으로 다시 열지 않음
    const caret = bodyEl.selectionStart ?? 0;
    const precedingText = bodyEl.value.slice(Math.max(0, caret - BOOKMARK_TRIGGER.length), caret);
    if (precedingText === BOOKMARK_TRIGGER) {
      openBookmarkModal({ start: caret - BOOKMARK_TRIGGER.length, end: caret });
    }
  });

  function renderPreview() {
    const seq = ++previewRenderSeq;
    try {
      const rawBody = bodyEl.value || '_(본문 없음)_';
      const postCardTags = Array.from(rawBody.matchAll(POST_CARD_RE));
      const bodyForMarked = rawBody.replace(POST_CARD_RE, (_match, slug, category) => {
        const meta = postCardMetaCache.get(`${category}/${slug}`) ?? null;
        return postCardHtml(category, slug, meta);
      });
      previewEl.innerHTML = marked.parse(bodyForMarked);

      // 캐시에 없던 PostCard는 비동기로 메타를 가져온 뒤 다시 렌더링(캐시가 채워지면
      // 위 replace에서 바로 실제 카드로 나온다). 이 렌더링 이후 본문이 또 바뀌었다면
      // seq가 달라져 있으므로 낡은 결과라 무시.
      const uncached = postCardTags.filter(([, slug, category]) => !postCardMetaCache.has(`${category}/${slug}`));
      if (uncached.length > 0) {
        Promise.all(uncached.map(([, slug, category]) => fetchPostCardMeta(category, slug))).then(() => {
          if (seq !== previewRenderSeq) return;
          renderPreview();
        });
      }

      const imgs = Array.from(previewEl.querySelectorAll('img'));
      if (imgs.length === 0) return;

      const applyKnown = () => {
        imgs.forEach((img) => {
          const src = img.getAttribute('src') ?? '';
          const filename = src.split('/').pop() ?? '';
          const blobUrl = localImagePreviews.get(filename);
          if (blobUrl) img.src = blobUrl;
        });
      };
      applyKnown();

      // 폴더가 연결되어 있으면, 아직 캐시에 없는 이미지들은 폴더에서 찾아본 뒤 다시 적용.
      if (imagesDirHandle) {
        const missing = imgs
          .map((img) => (img.getAttribute('src') ?? '').split('/').pop() ?? '')
          .filter((name) => name && !localImagePreviews.has(name));
        if (missing.length > 0) {
          Promise.all(missing.map((name) => tryResolveFromImagesDir(name))).then((results) => {
            // 이 렌더링 이후 본문이 또 바뀌어 새 렌더링이 시작됐다면 낡은 결과이므로 버림.
            if (seq !== previewRenderSeq) return;
            if (results.some(Boolean)) applyKnown();
          });
        }
      }
    } catch {
      previewEl.textContent = '미리보기 렌더링 실패';
    }
  }

  function applyPreviewState() {
    bodySplitEl.classList.toggle('preview-off', !previewOn);
    previewToggleBtn.textContent = previewOn ? '미리보기 숨기기' : '미리보기 보이기';
    if (previewOn) renderPreview();
  }

  previewToggleBtn.addEventListener('click', () => {
    previewOn = !previewOn;
    applyPreviewState();
  });

  // ---------- 자동저장 (localStorage) ----------
  // 브라우저 탭이 실수로 닫히거나 새로고침되어도 작업 내용을 잃지 않도록,
  // 폼 필드+본문을 주기적으로(디바운스) localStorage에 저장해둔다.
  // 서버에는 저장되지 않으며 이 브라우저에만 남는 임시 초안이다.
  const DRAFT_KEY = 'deaf52-editor-draft';
  let autosaveTimer: ReturnType<typeof setTimeout> | null = null;

  function collectDraft() {
    return {
      category: categorySelect.value,
      existing: existingSelect.value,
      fields: {
        title: fields.title.value,
        description: fields.description.value,
        lang: fields.lang.value,
        translationKey: fields.translationKey.value,
        slug: fields.slug.value,
        publishedAt: fields.publishedAt.value,
        tech: getTechValue(),
        heroImage: fields.heroImage.value,
        draft: fields.draft.checked,
      },
      body: bodyEl.value,
      savedAt: new Date().toISOString(),
    };
  }

  function saveDraft() {
    try {
      localStorage.setItem(DRAFT_KEY, JSON.stringify(collectDraft()));
    } catch {
      // localStorage 사용 불가(프라이빗 모드 등) - 조용히 무시, 자동저장만 안 될 뿐 편집은 계속 가능
    }
  }

  function scheduleAutosave() {
    if (autosaveTimer) clearTimeout(autosaveTimer);
    autosaveTimer = setTimeout(saveDraft, 800);
  }

  function clearDraft() {
    try {
      localStorage.removeItem(DRAFT_KEY);
    } catch {
      // 무시
    }
    setStatus('임시저장된 초안을 지웠습니다.');
  }

  function restoreDraftIfAny() {
    let raw: string | null = null;
    try {
      raw = localStorage.getItem(DRAFT_KEY);
    } catch {
      return;
    }
    if (!raw) return;
    try {
      const draft = JSON.parse(raw);
      const when = draft.savedAt ? new Date(draft.savedAt).toLocaleString('ko-KR', { hour12: false }) : '알 수 없음';
      if (!confirm(`임시저장된 초안이 있습니다 (${when} 저장).\n불러올까요? (취소하면 초안은 유지되되 무시합니다)`)) {
        return;
      }
      categorySelect.value = draft.category ?? 'it';
      updateCategoryFields();
      const f = draft.fields ?? {};
      fields.title.value = f.title ?? '';
      fields.description.value = f.description ?? '';
      fields.lang.value = f.lang ?? 'ko';
      fields.translationKey.value = f.translationKey ?? '';
      fields.slug.value = f.slug ?? '';
      fields.publishedAt.value = f.publishedAt ?? new Date().toISOString().slice(0, 10);
      setTechValue(f.tech ?? '');
      fields.heroImage.value = f.heroImage ?? '';
      heroImageSelect.value = '';
      fields.draft.checked = !!f.draft;
      bodyEl.value = draft.body ?? '';
      if (previewOn) renderPreview();
      setStatus('임시저장된 초안을 불러왔습니다.');
    } catch {
      // 손상된 초안 데이터 - 무시
    }
  }

  // 입력 시마다 디바운스 자동저장 (폼 필드 + 본문 전체)
  // 참고: 기술 태그 체크박스들은 renderTechCheckboxList에서 개별적으로 리스너를 붙인다
  // (목록이 나중에 동적으로 채워지므로 여기서 한 번에 잡을 수 없음).
  [
    fields.title,
    fields.description,
    fields.lang,
    fields.translationKey,
    fields.slug,
    fields.publishedAt,
    fields.heroImage,
    fields.draft,
  ].forEach((el) => {
    el.addEventListener('input', scheduleAutosave);
    el.addEventListener('change', scheduleAutosave);
  });
  bodyEl.addEventListener('input', () => {
    scheduleAutosave();
    if (previewOn) renderPreview();
  });

  clearDraftBtn.addEventListener('click', clearDraft);

  categorySelect.addEventListener('change', () => {
    updateCategoryFields();
    loadList();
    scheduleAutosave();
  });
  existingSelect.addEventListener('change', loadExisting);
  loadListBtn.addEventListener('click', () => {
    // "⟳ 목록 새로고침"은 Worker의 KV 캐시(?refresh=1)뿐 아니라, 북마크 모달이
    // 클라이언트 메모리에 들고 있는 캐시(bookmarkCandidatesLoaded)도 함께 비운다 -
    // 안 그러면 새로고침 버튼을 눌러도 북마크 모달은 페이지를 새로고침(F5)하기
    // 전까지 예전 목록을 계속 보여주게 된다.
    bookmarkCandidatesLoaded = false;
    loadList(true);
  });
  downloadBtn.addEventListener('click', download);

  updateCategoryFields();
  resetForm();
  applyPreviewState();
  loadList();
  loadImageList();
  // 태그 체크박스 목록이 채워진 뒤에 초안을 복원해야, 초안에 담긴 태그들이 체크박스로
  // 정확히 매칭된다 (먼저 복원하면 목록이 비어있어 전부 "직접입력"으로 밀려버림).
  loadTagList().then(restoreDraftIfAny);
</script>
