---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TranslationReport from '../../../components/TranslationReport.astro';
import { getTranslations, LOCALE_PREFIX_RE } from '../../../i18n/utils';
import { formatDate } from '../../../i18n/formatDate';

export async function getStaticPaths() {
  const entries = await getCollection('it');
  return entries.map((entry) => ({
    params: { lang: entry.data.lang, slug: entry.slug.replace(LOCALE_PREFIX_RE, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const cleanSlug = entry.slug.replace(LOCALE_PREFIX_RE, '');
const translations = await getTranslations(entry, 'it');
const availableLangs = Object.keys(translations) as Array<typeof entry.data.lang>;
// translationKey는 같아도 언어마다 파일명(slug)이 다를 수 있어서, 언어전환 링크가
// 잘못된 주소로 새지 않도록 언어별 실제 slug를 같이 넘긴다.
const slugOverrides = Object.fromEntries(
  Object.entries(translations).map(([lang, sibling]) => [lang, sibling!.slug.replace(LOCALE_PREFIX_RE, '')])
);
// hreflang용: 실제로 번역이 존재하는 언어의 절대경로만 만든다 (없는 언어는 아예 제외 -
// 존재하지 않는 페이지를 hreflang으로 걸면 검색엔진에 잘못된 신호가 된다).
const hreflangPaths = Object.fromEntries(
  Object.entries(slugOverrides).map(([lang, slug]) => [lang, `/${lang}/it/${slug}/`])
);
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  availableLangs={availableLangs}
  slugOverrides={slugOverrides}
  hreflangPaths={hreflangPaths}
  ogImage={entry.data.heroImage}
  ogType="article"
  showSidebar
>
  <div class="post-meta-bar">
    <span class="post-tag it">IT · {entry.data.tech.join(', ')}</span>
  </div>
  <h1 class="post-title">{entry.data.title}</h1>
  <div class="post-date-row">
    <time class="post-date">{formatDate(entry.data.publishedAt, entry.data.lang)}</time>
    <span class="post-views" data-slug={cleanSlug}>조회수 불러오는 중...</span>
  </div>
  <article class="post-body">
    <Content />
  </article>
  <div class="like-bar">
    <button class="like-button" data-slug={cleanSlug} aria-pressed="false">
      <span class="like-icon">♡</span>
      <span class="like-count">-</span>
    </button>
  </div>
  <TranslationReport slug={cleanSlug} lang={entry.data.lang} />
</BaseLayout>

<script>
  const viewEl = document.querySelector('.post-views');
  if (viewEl) {
    const slug = viewEl.getAttribute('data-slug');
    fetch(`/api/counter/post?slug=${encodeURIComponent(slug ?? '')}`)
      .then((res) => res.json())
      .then((data) => {
        viewEl.textContent = `조회 ${data.count.toLocaleString()}`;
      })
      .catch(() => {
        viewEl.textContent = '';
      });
  }

  const likeBtn = document.querySelector('.like-button');
  if (likeBtn) {
    const slug = likeBtn.getAttribute('data-slug') ?? '';
    const storageKey = `liked:${slug}`;
    const countEl = likeBtn.querySelector('.like-count');
    const iconEl = likeBtn.querySelector('.like-icon');

    function render(liked, count) {
      likeBtn.setAttribute('aria-pressed', String(liked));
      likeBtn.classList.toggle('liked', liked);
      if (iconEl) iconEl.textContent = liked ? '♥' : '♡';
      if (countEl) countEl.textContent = String(count);
    }

    fetch(`/api/like/post?slug=${encodeURIComponent(slug)}`)
      .then((res) => res.json())
      .then((data) => {
        const liked = localStorage.getItem(storageKey) === '1';
        render(liked, data.count);
      })
      .catch(() => {
        if (countEl) countEl.textContent = '0';
      });

    likeBtn.addEventListener('click', () => {
      const currentlyLiked = localStorage.getItem(storageKey) === '1';
      const nextLiked = !currentlyLiked;

      likeBtn.setAttribute('disabled', 'true');
      fetch(`/api/like/post?slug=${encodeURIComponent(slug)}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ liked: nextLiked }),
      })
        .then((res) => res.json())
        .then((data) => {
          localStorage.setItem(storageKey, nextLiked ? '1' : '0');
          render(nextLiked, data.count);
          // 좋아요를 누른 경우만 전환 이벤트로 카운트 (취소는 제외)
          if (nextLiked && window.dataLayer) {
            window.dataLayer.push({ event: 'post_like', slug });
          }
        })
        .finally(() => {
          likeBtn.removeAttribute('disabled');
        });
    });
  }
</script>
