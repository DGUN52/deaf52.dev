---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export function getStaticPaths() {
  return [
    { params: { lang: 'ko' } },
    { params: { lang: 'en' } },
  ];
}

const { lang } = Astro.params;

const posts = (await getCollection('it'))
  .filter((p) => p.data.lang === lang && !p.data.draft)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

// tech 태그별로 묶어서 몇 개 있는지 보여주기
const techCounts = new Map<string, number>();
posts.forEach((p) => {
  p.data.tech.forEach((t) => techCounts.set(t, (techCounts.get(t) ?? 0) + 1));
});

const t = lang === 'ko'
  ? { title: 'IT기술', sub: '기술별 기록', empty: '아직 작성된 글이 없습니다.' }
  : { title: 'Tech', sub: 'notes by technology', empty: 'No posts yet.' };
---

<BaseLayout title={t.title}>
  <div class="section-heading it">
    <span class="marker">01</span>
    <h2>{t.title}</h2>
  </div>
  <p class="section-sub">{t.sub} &middot; {posts.length}{lang === 'ko' ? '개 글' : ' posts'}</p>

  {techCounts.size > 0 && (
    <div class="tech-filter">
      {[...techCounts.entries()].map(([tech, count]) => (
        <span class="tech-chip">{tech} <em>{count}</em></span>
      ))}
    </div>
  )}

  {posts.length === 0 && <p class="empty-state">{t.empty}</p>}
  <ul class="post-list it">
    {posts.map((post, i) => (
      <li>
        <span class="index">{String(i + 1).padStart(2, '0')}</span>
        <a href={`/${lang}/it/${post.slug.replace(/^(ko|en)\//, '')}`}>
          {post.data.title}
        </a>
        <span class="tags">{post.data.tech.join(' / ')}</span>
      </li>
    ))}
  </ul>
</BaseLayout>
