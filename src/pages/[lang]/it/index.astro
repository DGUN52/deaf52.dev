---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { LOCALES, LOCALE_PREFIX_RE } from '../../../i18n/utils';
import { formatDate } from '../../../i18n/formatDate';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params;

const posts = (await getCollection('it'))
  .filter((p) => p.data.lang === lang && !p.data.draft)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const t = lang === 'ko'
  ? { title: 'IT기술', sub: '기술별 기록', empty: '아직 작성된 글이 없습니다.', latest: '최신순 보기', grouped: '기술별 보기' }
  : { title: 'Tech', sub: 'notes by technology', empty: 'No posts yet.', latest: 'Latest', grouped: 'By Technology' };

// 카테고리 목록 페이지 자체를 대표하는 SEO용 title/description (9개 언어).
// 위 t.title/t.sub는 화면에 보이는 섹션 제목이고, 이건 <title>/<meta description> 전용 -
// BaseLayout에 description을 안 넘기면 사이트 공통 기본 문구로 폴백되어 모든 언어의
// 목록 페이지가 똑같은 description을 갖게 되는 문제가 있었다 (Search Console에서 발견).
const seoText: Record<string, { title: string; description: string }> = {
  ko: { title: 'IT기술 · deaf52', description: 'deaf52의 IT 기술 글 모음. Docker, MongoDB, 알고리즘 등 기술별로 정리된 개발 기록.' },
  en: { title: 'Tech · deaf52', description: "deaf52's IT & tech articles, organized by technology - Docker, MongoDB, algorithms, and more." },
  ja: { title: 'IT技術 · deaf52', description: 'deaf52のIT技術記事一覧。Docker、MongoDB、アルゴリズムなど技術別に整理された開発記録。' },
  zh: { title: 'IT技术 · deaf52', description: 'deaf52的IT技术文章合集，按技术分类整理，涵盖Docker、MongoDB、算法等开发笔记。' },
  in: { title: 'टेक · deaf52', description: 'deaf52 के IT और तकनीक लेख, तकनीक के अनुसार व्यवस्थित - Docker, MongoDB, एल्गोरिदम और अधिक।' },
  de: { title: 'Tech · deaf52', description: 'IT-Artikel von deaf52, sortiert nach Technologie - Docker, MongoDB, Algorithmen und mehr.' },
  uk: { title: 'Tech · deaf52', description: "deaf52's IT & tech articles, organised by technology - Docker, MongoDB, algorithms, and more." },
  il: { title: 'טכנולוגיה · deaf52', description: 'מאמרי IT וטכנולוגיה של deaf52, מאורגנים לפי טכנולוגיה - Docker, MongoDB, אלגוריתמים ועוד.' },
  tw: { title: 'IT技術 · deaf52', description: 'deaf52的IT技術文章合集，依技術分類整理，涵蓋Docker、MongoDB、演算法等開發筆記。' },
};
const seo = seoText[lang] ?? seoText.en;

// Group posts by tech tags
const groupedPosts = new Map<string, typeof posts>();
posts.forEach(p => {
  p.data.tech.forEach(t => {
    if (!groupedPosts.has(t)) groupedPosts.set(t, []);
    groupedPosts.get(t)!.push(p);
  });
});
---

<BaseLayout title={seo.title} description={seo.description}>
  <div class="section-heading it">
    <span class="marker">01</span>
    <h2>{t.title}</h2>
  </div>
  <p class="section-sub">{t.sub} &middot; {posts.length}{lang === 'ko' ? '개 글' : ' posts'}</p>

  {posts.length === 0 && <p class="empty-state">{t.empty}</p>}

  {posts.length > 0 && (
    <>
      <div class="view-toggle">
        <!-- IT default: Latest view -->
        <button id="btn-latest" class="active">{t.latest}</button>
        <button id="btn-grouped">{t.grouped}</button>
      </div>

      <div id="view-latest" class="view-section active">
        <ul class="post-list it">
          {posts.map((post, i) => (
            <li>
              <span class="index">{String(i + 1).padStart(2, '0')}</span>
              <a href={`/${lang}/it/${post.slug.replace(LOCALE_PREFIX_RE, '')}`}>
                {post.data.title}
              </a>
              <span class="tags">
                {post.data.tech.map((t) => <span class="tag-pill">{t}</span>)}
              </span>
            </li>
          ))}
        </ul>
      </div>

      <div id="view-grouped" class="view-section">
        {[...groupedPosts.entries()].map(([tech, techPosts]) => (
          <div>
            <h3 class="group-title">{tech}</h3>
            <ul class="post-list it">
              {techPosts.map((post, i) => (
                <li>
                  <span class="index">{String(i + 1).padStart(2, '0')}</span>
                  <a href={`/${lang}/it/${post.slug.replace(LOCALE_PREFIX_RE, '')}`}>
                    {post.data.title}
                  </a>
                  <span class="tags">{formatDate(post.data.publishedAt, post.data.lang)}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </>
  )}
</BaseLayout>

<script>
  // Setup toggle events
  const btnLatest = document.getElementById('btn-latest');
  const btnGrouped = document.getElementById('btn-grouped');
  const viewLatest = document.getElementById('view-latest');
  const viewGrouped = document.getElementById('view-grouped');

  btnLatest?.addEventListener('click', () => {
    btnLatest.classList.add('active');
    btnGrouped?.classList.remove('active');
    viewLatest?.classList.add('active');
    viewGrouped?.classList.remove('active');
  });

  btnGrouped?.addEventListener('click', () => {
    btnGrouped.classList.add('active');
    btnLatest?.classList.remove('active');
    viewGrouped?.classList.add('active');
    viewLatest?.classList.remove('active');
  });
</script>