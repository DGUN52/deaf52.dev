---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export function getStaticPaths() {
  return [
    { params: { lang: 'ko' } },
    { params: { lang: 'en' } },
  ];
}

const { lang } = Astro.params;

const itPosts = (await getCollection('it'))
  .filter((p) => p.data.lang === lang && !p.data.draft)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const humanitiesPosts = (await getCollection('humanities'))
  .filter((p) => p.data.lang === lang && !p.data.draft)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const t = lang === 'ko'
  ? { it: 'IT기술', itSub: '기술별 기록', humanities: '인문학', humanitiesSub: '리뷰・사색・글쓰기', empty: '아직 작성된 글이 없습니다.' }
  : { it: 'Tech', itSub: 'notes by technology', humanities: 'Humanities', humanitiesSub: 'reviews, reflections, writing', empty: 'No posts yet.' };

const subcategoryLabel: Record<string, string> = {
  review: lang === 'ko' ? '리뷰' : 'review',
  reflection: lang === 'ko' ? '사색' : 'reflection',
  fiction: lang === 'ko' ? '픽션' : 'fiction',
  nonfiction: lang === 'ko' ? '논픽션' : 'nonfiction',
};
---

<BaseLayout title={lang === 'ko' ? 'DB와 인문학' : 'DB & Humanities'}>
  <section>
    <div class="section-heading it">
      <span class="marker">01</span>
      <h2><a href={`/${lang}/it/`}>{t.it}</a></h2>
    </div>
    <p class="section-sub">{t.itSub}</p>

    {itPosts.length === 0 && <p class="empty-state">{t.empty}</p>}
    <ul class="post-list it">
      {itPosts.map((post, i) => (
        <li>
          <span class="index">{String(i + 1).padStart(2, '0')}</span>
          <a href={`/${lang}/it/${post.slug.replace(/^(ko|en)\//, '')}`}>
            {post.data.title}
          </a>
          <span class="tags">{post.data.tech.join(' / ')}</span>
        </li>
      ))}
    </ul>
  </section>

  <section>
    <div class="section-heading humanities">
      <span class="marker">02</span>
      <h2><a href={`/${lang}/humanities/`}>{t.humanities}</a></h2>
    </div>
    <p class="section-sub">{t.humanitiesSub}</p>

    {humanitiesPosts.length === 0 && <p class="empty-state">{t.empty}</p>}
    <ul class="post-list humanities">
      {humanitiesPosts.map((post) => (
        <li>
          <span class="eyebrow">{subcategoryLabel[post.data.subcategory]}</span>
          <a href={`/${lang}/humanities/${post.slug.replace(/^(ko|en)\//, '')}`}>
            {post.data.title}
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
