---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { LOCALES, LOCALE_PREFIX_RE, type Locale } from '../../i18n/utils';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };

const itPosts = (await getCollection('it'))
  .filter((p) => p.data.lang === lang && !p.data.draft)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const humanitiesPosts = (await getCollection('humanities'))
  .filter((p) => p.data.lang === lang && !p.data.draft)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const t = lang === 'ko'
  ? { it: 'IT기술', itSub: '기술별 기록', humanities: '인문학', humanitiesSub: '리뷰・사색・글쓰기', empty: '아직 작성된 글이 없습니다.', popular: '인기 글', popularViews: '조회수 TOP' }
  : { it: 'Tech', itSub: 'notes by technology', humanities: 'Humanities', humanitiesSub: 'reviews, reflections, writing', empty: 'No posts yet.', popular: 'Popular', popularViews: 'Most viewed' };

// 홈페이지 자체를 대표하는 SEO용 title/description (9개 언어).
// 예전엔 title이 언어와 무관하게 항상 "deaf52" 고정값이었고 description도 전달 안 해서
// BaseLayout의 사이트 공통 기본 문구로 폴백됐다 - 9개 언어 홈이 전부 동일한 title/description을
// 갖게 되는 문제가 있었다 (Search Console에서 발견).
const seoText: Record<string, { title: string; description: string }> = {
  ko: { title: 'deaf52', description: 'deaf52 · IT 기술과 인문학을 함께 기록하는 개인 블로그.' },
  en: { title: 'deaf52', description: 'deaf52 · A personal blog on IT & technology, and the humanities.' },
  ja: { title: 'deaf52', description: 'deaf52 · IT技術と人文学を綴る個人ブログ。' },
  zh: { title: 'deaf52', description: 'deaf52 · 记录IT技术与人文学的个人博客。' },
  in: { title: 'deaf52', description: 'deaf52 · IT और मानविकी पर एक व्यक्तिगत ब्लॉग।' },
  de: { title: 'deaf52', description: 'deaf52 · Ein persönlicher Blog über IT & Technologie sowie Geisteswissenschaften.' },
  uk: { title: 'deaf52', description: 'deaf52 · A personal blog on IT & technology, and the humanities.' },
  il: { title: 'deaf52', description: 'deaf52 · בלוג אישי על IT וטכנולוגיה, וכן מדעי הרוח.' },
  tw: { title: 'deaf52', description: 'deaf52 · 記錄IT技術與人文學的個人部落格。' },
};
const seo = seoText[lang] ?? seoText.en;

const subcategoryLabel: Record<string, string> = {
  review: lang === 'ko' ? '리뷰' : 'review',
  reflection: lang === 'ko' ? '사색' : 'reflection',
  fiction: lang === 'ko' ? '픽션' : 'fiction',
  nonfiction: lang === 'ko' ? '논픽션' : 'nonfiction',
};

// 클라이언트에서 slug -> {title, category} 매핑으로 인기글 API 결과를 표시에 쓸 수 있도록
// 빌드 타임에 미리 데이터를 만들어 심어둔다.
const postMeta: Record<string, { title: string; category: 'it' | 'humanities' }> = {};
for (const p of itPosts) {
  postMeta[p.slug.replace(LOCALE_PREFIX_RE, '')] = { title: p.data.title, category: 'it' };
}
for (const p of humanitiesPosts) {
  postMeta[p.slug.replace(LOCALE_PREFIX_RE, '')] = { title: p.data.title, category: 'humanities' };
}
---

<BaseLayout title={seo.title} description={seo.description}>
  <section class="popular-section">
    <div class="section-heading popular">
      <span class="marker">★</span>
      <h2>{t.popular}</h2>
    </div>
    <div class="popular-grid popular-grid-single">
      <div class="popular-col">
        <p class="popular-col-title">{t.popularViews}</p>
        <ol class="popular-list" id="popular-views" data-metric="views"></ol>
      </div>
    </div>
  </section>

  <section>
    <div class="section-heading it">
      <span class="marker">01</span>
      <h2><a href={`/${lang}/it/`}>{t.it}</a></h2>
    </div>
    <p class="section-sub">{t.itSub}</p>

    {itPosts.length === 0 && <p class="empty-state">{t.empty}</p>}
    <ul class="post-list it">
      {itPosts.map((post, i) => (
        <li>
          <span class="index">{String(i + 1).padStart(2, '0')}</span>
          <a href={`/${lang}/it/${post.slug.replace(LOCALE_PREFIX_RE, '')}`}>
            {post.data.title}
          </a>
          <span class="tags">
            {post.data.tech.map((t) => <span class="tag-pill">{t}</span>)}
          </span>
        </li>
      ))}
    </ul>
  </section>

  <section>
    <div class="section-heading humanities">
      <span class="marker">02</span>
      <h2><a href={`/${lang}/humanities/`}>{t.humanities}</a></h2>
    </div>
    <p class="section-sub">{t.humanitiesSub}</p>

    {humanitiesPosts.length === 0 && <p class="empty-state">{t.empty}</p>}
    <ul class="post-list humanities">
      {humanitiesPosts.map((post) => (
        <li>
          <span class="eyebrow">{subcategoryLabel[post.data.subcategory]}</span>
          <a href={`/${lang}/humanities/${post.slug.replace(LOCALE_PREFIX_RE, '')}`}>
            {post.data.title}
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<script define:vars={{ postMeta, lang }}>
  async function loadPopular(elId, metric) {
    const el = document.getElementById(elId);
    if (!el) return;
    try {
      const res = await fetch(`/api/ranking?metric=${metric}&limit=5`);
      const data = await res.json();
      const items = (data.items || [])
        .map((item) => ({ ...item, meta: postMeta[item.slug] }))
        .filter((item) => item.meta); // 현재 언어에 존재하는 글만

      if (items.length === 0) {
        el.innerHTML = '<li class="popular-empty">-</li>';
        return;
      }

      el.innerHTML = items
        .map(
          (item) => `
        <li>
          <a href="/${lang}/${item.meta.category}/${item.slug}">${item.meta.title}</a>
          <span class="popular-count">${item.count.toLocaleString()}</span>
        </li>
      `
        )
        .join('');
    } catch {
      el.innerHTML = '<li class="popular-empty">-</li>';
    }
  }

  loadPopular('popular-views', 'views');
</script>
