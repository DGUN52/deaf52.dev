const t = DICT[lang] ?? DICT.en;
---

<BaseLayout title={t.title}>
  <article class="privacy-page" dir={lang === 'il' ? 'rtl' : 'ltr'}>
    <h1>{t.title}</h1>
    <p class="privacy-updated">{t.updated}</p>
    <p class="privacy-intro">{t.intro}</p>
    {t.sections.map((s) => (
      <section class="privacy-section">
        <h2>{s.heading}</h2>
        {s.body.map((p) => <p>{p}</p>)}
      </section>
    ))}
  </article>
</BaseLayout>
