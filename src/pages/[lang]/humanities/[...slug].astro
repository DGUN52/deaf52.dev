---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getTranslations } from '../../../i18n/utils';

export async function getStaticPaths() {
  const entries = await getCollection('humanities');
  return entries.map((entry) => ({
    params: { lang: entry.data.lang, slug: entry.slug.replace(/^(ko|en)\//, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const subcategoryLabel: Record<string, string> = {
  review: '리뷰',
  reflection: '사색',
  fiction: '픽션',
  nonfiction: '논픽션',
};
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <div class="post-meta-bar">
    <span class="post-tag humanities">인문학 · {subcategoryLabel[entry.data.subcategory]}</span>
  </div>
  <h1 class="post-title">{entry.data.title}</h1>
  <time class="post-date">{entry.data.publishedAt.toLocaleDateString()}</time>
  <article class="post-body">
    <Content />
  </article>
</BaseLayout>
