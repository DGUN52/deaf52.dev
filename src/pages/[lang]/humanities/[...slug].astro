---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getTranslations, LOCALE_PREFIX_RE } from '../../../i18n/utils';

export async function getStaticPaths() {
  const entries = await getCollection('humanities');
  return entries.map((entry) => ({
    params: { lang: entry.data.lang, slug: entry.slug.replace(LOCALE_PREFIX_RE, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const cleanSlug = entry.slug.replace(LOCALE_PREFIX_RE, '');
const translations = await getTranslations(entry, 'humanities');
const availableLangs = Object.keys(translations) as Array<typeof entry.data.lang>;

const subcategoryLabel: Record<string, string> = {
  review: '리뷰',
  reflection: '사색',
  fiction: '픽션',
  nonfiction: '논픽션',
};
---

<BaseLayout title={entry.data.title} description={entry.data.description} availableLangs={availableLangs}>
  <div class="post-meta-bar">
    <span class="post-tag humanities">인문학 · {subcategoryLabel[entry.data.subcategory]}</span>
  </div>
  <h1 class="post-title">{entry.data.title}</h1>
  <div class="post-date-row">
    <time class="post-date">{entry.data.publishedAt.toLocaleDateString()}</time>
    <span class="post-views" data-slug={cleanSlug}>조회수 불러오는 중...</span>
  </div>
  <article class="post-body">
    <Content />
  </article>
  <div class="like-bar">
    <button class="like-button" data-slug={cleanSlug} aria-pressed="false">
      <span class="like-icon">♡</span>
      <span class="like-count">-</span>
    </button>
  </div>
</BaseLayout>

<script>
  const viewEl = document.querySelector('.post-views');
  if (viewEl) {
    const slug = viewEl.getAttribute('data-slug');
    fetch(`/api/counter/post?slug=${encodeURIComponent(slug ?? '')}`)
      .then((res) => res.json())
      .then((data) => {
        viewEl.textContent = `조회 ${data.count.toLocaleString()}`;
      })
      .catch(() => {
        viewEl.textContent = '';
      });
  }

  const likeBtn = document.querySelector('.like-button');
  if (likeBtn) {
    const slug = likeBtn.getAttribute('data-slug') ?? '';
    const storageKey = `liked:${slug}`;
    const countEl = likeBtn.querySelector('.like-count');
    const iconEl = likeBtn.querySelector('.like-icon');

    function render(liked, count) {
      likeBtn.setAttribute('aria-pressed', String(liked));
      likeBtn.classList.toggle('liked', liked);
      if (iconEl) iconEl.textContent = liked ? '♥' : '♡';
      if (countEl) countEl.textContent = String(count);
    }

    fetch(`/api/like/post?slug=${encodeURIComponent(slug)}`)
      .then((res) => res.json())
      .then((data) => {
        const liked = localStorage.getItem(storageKey) === '1';
        render(liked, data.count);
      })
      .catch(() => {
        if (countEl) countEl.textContent = '0';
      });

    likeBtn.addEventListener('click', () => {
      const currentlyLiked = localStorage.getItem(storageKey) === '1';
      const nextLiked = !currentlyLiked;

      likeBtn.setAttribute('disabled', 'true');
      fetch(`/api/like/post?slug=${encodeURIComponent(slug)}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ liked: nextLiked }),
      })
        .then((res) => res.json())
        .then((data) => {
          localStorage.setItem(storageKey, nextLiked ? '1' : '0');
          render(nextLiked, data.count);
        })
        .finally(() => {
          likeBtn.removeAttribute('disabled');
        });
    });
  }
</script>
