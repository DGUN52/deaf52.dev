---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { LOCALES, LOCALE_PREFIX_RE } from '../../../i18n/utils';
import { formatDateShort } from '../../../i18n/formatDate';
import { siteConfig } from '../../../site.config';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;

const posts = (await getCollection('humanities'))
  .filter((p) => p.data.lang === lang && !p.data.draft)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const subcategoryLabel: Record<string, string> = {
  review: lang === 'ko' ? '리뷰' : 'review',
  reflection: lang === 'ko' ? '사색' : 'reflection',
  fiction: lang === 'ko' ? '픽션' : 'fiction',
  nonfiction: lang === 'ko' ? '논픽션' : 'nonfiction',
};

const t = lang === 'ko'
  ? { title: '인문학', sub: '리뷰・사색・글쓰기', empty: '아직 작성된 글이 없습니다.', latest: '최신순 보기', grouped: '소분류별 보기' }
  : { title: 'Humanities', sub: 'reviews, reflections, writing', empty: 'No posts yet.', latest: 'Latest', grouped: 'By Category' };

// 카테고리 목록 페이지 자체를 대표하는 SEO용 title/description (9개 언어).
// 위 t.title/t.sub는 화면에 보이는 섹션 제목이고, 이건 <title>/<meta description> 전용 -
// BaseLayout에 description을 안 넘기면 사이트 공통 기본 문구로 폴백되어 모든 언어의
// 목록 페이지가 똑같은 description을 갖게 되는 문제가 있었다 (Search Console에서 발견).
// title/description 모두 "인문학"과 "deaf52" 같은 고유명사 부분만 언어별 값으로 두고,
// 사이트 이름이 들어가는 자리는 siteConfig.siteName을 함수로 끼워넣는다(포크 시 자동 반영).
const seoTextTemplate: Record<string, { title: string; description: (name: string) => string }> = {
  ko: { title: '인문학', description: (name) => `${name}의 인문학 글 모음. 리뷰, 사색, 픽션, 논픽션 등 다양한 글쓰기.` },
  en: { title: 'Humanities', description: (name) => `${name}'s humanities writing - reviews, reflections, fiction, and nonfiction.` },
  ja: { title: '人文学', description: (name) => `${name}の人文学記事一覧。レビュー、随想、フィクション、ノンフィクションなど。` },
  zh: { title: '人文学', description: (name) => `${name}的人文学文章合集，包括书评、随笔、小说与非虚构写作。` },
  in: { title: 'मानविकी', description: (name) => `${name} के मानविकी लेख - समीक्षाएं, चिंतन, कथा और गैर-कथा लेखन।` },
  de: { title: 'Geisteswissenschaften', description: (name) => `Essays von ${name} zu Geisteswissenschaften - Rezensionen, Reflexionen, Fiktion und Sachtexte.` },
  uk: { title: 'Humanities', description: (name) => `${name}'s humanities writing - reviews, reflections, fiction, and nonfiction.` },
  il: { title: 'מדעי הרוח', description: (name) => `כתיבה במדעי הרוח מאת ${name} - ביקורות, הגות, בדיה ופרוזה עיונית.` },
  tw: { title: '人文學', description: (name) => `${name}的人文學文章合集，包括書評、隨筆、小說與非虛構寫作。` },
};
const seoTemplate = seoTextTemplate[lang] ?? seoTextTemplate.en;
const seo = {
  title: `${seoTemplate.title} · ${siteConfig.siteName}`,
  description: seoTemplate.description(siteConfig.siteName),
};

// Group posts by subcategory
const groupedPosts = new Map<string, typeof posts>();
posts.forEach(p => {
  const sub = p.data.subcategory;
  if (!groupedPosts.has(sub)) groupedPosts.set(sub, []);
  groupedPosts.get(sub)!.push(p);
});
---

<BaseLayout title={seo.title} description={seo.description}>
  <div class="section-heading humanities">
    <h2>{t.title}</h2>
  </div>
  <p class="section-sub">{t.sub} &middot; {posts.length}{lang === 'ko' ? '개 글' : ' posts'}</p>

  {posts.length === 0 && <p class="empty-state">{t.empty}</p>}

  {posts.length > 0 && (
    <>
      <div class="view-toggle">
        <button id="btn-latest">{t.latest}</button>
        <!-- Humanities default: Grouped view -->
        <button id="btn-grouped" class="active">{t.grouped}</button>
      </div>

      <div id="view-latest" class="view-section">
        <ul class="post-list humanities has-dates">
          {posts.map((post) => (
            <li>
              <span class="index">{formatDateShort(post.data.publishedAt)}</span>
              <a href={`/${lang}/humanities/${post.slug.replace(LOCALE_PREFIX_RE, '')}`}>
                {post.data.title}
              </a>
              <span class="tags">{subcategoryLabel[post.data.subcategory]}</span>
            </li>
          ))}
        </ul>
      </div>

      <div id="view-grouped" class="view-section active">
        {[...groupedPosts.entries()].map(([sub, subPosts]) => (
          <div>
            <h3 class="group-title">{subcategoryLabel[sub]}</h3>
            <ul class="post-list humanities has-dates">
              {subPosts.map((post) => (
                <li>
                  <span class="index">{formatDateShort(post.data.publishedAt)}</span>
                  <a href={`/${lang}/humanities/${post.slug.replace(LOCALE_PREFIX_RE, '')}`}>
                    {post.data.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </>
  )}
</BaseLayout>

<script>
  // Setup toggle events
  const btnLatest = document.getElementById('btn-latest');
  const btnGrouped = document.getElementById('btn-grouped');
  const viewLatest = document.getElementById('view-latest');
  const viewGrouped = document.getElementById('view-grouped');

  btnLatest?.addEventListener('click', () => {
    btnLatest.classList.add('active');
    btnGrouped?.classList.remove('active');
    viewLatest?.classList.add('active');
    viewGrouped?.classList.remove('active');
  });

  btnGrouped?.addEventListener('click', () => {
    btnGrouped.classList.add('active');
    btnLatest?.classList.remove('active');
    viewGrouped?.classList.add('active');
    viewLatest?.classList.remove('active');
  });
</script>