---
import { LOCALE_LABELS, type Locale } from '../i18n/utils';

interface Props {
  translations: Partial<Record<Locale, { slug: string }>>;
  currentLang: Locale;
  collectionBasePath: string;
}

const { translations, currentLang, collectionBasePath } = Astro.props;
---

<div class="lang-switcher">
  <button class="lang-current" aria-haspopup="listbox">
    {LOCALE_LABELS[currentLang]} ▾
  </button>
  <ul class="lang-menu" role="listbox">
    {Object.entries(LOCALE_LABELS).map(([code, label]) => {
      const target = translations[code as Locale];
      const cleanSlug = target ? target.slug.replace(/^(ko|en)\//, '') : null;
      const href = target
        ? `/${code}${collectionBasePath}${cleanSlug}`
        : null;
      return (
        <li>
          {href ? (
            <a href={href} aria-current={code === currentLang ? 'true' : undefined}>
              {label}
            </a>
          ) : (
            <span class="lang-disabled" title="번역 준비중 / Not translated yet">
              {label} (준비중)
            </span>
          )}
        </li>
      );
    })}
  </ul>
</div>
