---
// src/components/PostCard.astro
//
// 글 본문(MDX) 안에서 다른 글을 "이전 글", "관련 글"처럼 참조할 때 쓰는
// 노션 스타일 북마크 카드. slug/category로 Content Collections에서
// title·description·heroImage를 직접 가져오므로 참조 대상 글의 내용이
// 나중에 바뀌어도 카드 쪽을 따로 안 고쳐도 된다.
//
// MDX 파일에서 사용 예:
//   <PostCard slug="migration-from-velog-to-astro-site1" category="it" />
//
// lang은 안 적어도 된다 - 지금 렌더링 중인 글의 URL(/ko/it/... 등)에서
// getLocaleFromUrl로 자동으로 뽑아온다. 번역 글마다 언어를 손으로 맞춰
// 적어야 한다면 9개 언어로 번역할 때마다 전부 고쳐야 해서 실수하기 쉬운데,
// 이렇게 하면 MDX 원문 그대로 번역만 해도 카드가 각 언어에 맞게 자동으로
// 그 언어 버전의 글을 찾아 보여준다.
//
// slug는 언어 prefix(ko/, en/ 등) 뗀 형태(cleanSlug)로 넘긴다. 번역이 아직
// 없는 언어라면 조용히 아무것도 렌더링하지 않는다(깨진 링크를 보여주는 것보다
// 안전한 폴백 - remark-responsive-images.mjs와 같은 관례).
//
// heroImage가 있으면 썸네일로, 우측엔 화살표 아이콘 + 하단엔 사이트 도메인을
// 표시해서 "클릭 가능한 이동 링크"라는 게 텍스트 카드처럼 안 보이는 문제를
// 시각적으로 분명히 한다 (일반 웹 링크 미리보기 카드와 같은 관례).
import { getCollection } from 'astro:content';
import { LOCALE_PREFIX_RE, getLocaleFromUrl } from '../i18n/utils';
import { siteConfig } from '../site.config';

interface Props {
  slug: string;
  category: 'it' | 'humanities';
}

const { slug, category } = Astro.props;
const lang = getLocaleFromUrl(Astro.url);

const entries = await getCollection(category);
const target = entries.find(
  (e) => e.data.lang === lang && e.slug.replace(LOCALE_PREFIX_RE, '') === slug
);

const domain = siteConfig.siteUrl.replace(/^https?:\/\//, '');
---

{target && (
  <a class="post-card" href={`/${lang}/${category}/${slug}/`}>
    {target.data.heroImage && (
      <img class="post-card-thumb" src={target.data.heroImage} alt="" loading="lazy" />
    )}
    <span class="post-card-body">
      <span class="post-card-title">{target.data.title}</span>
      <span class="post-card-desc">{target.data.description}</span>
      <span class="post-card-domain">{domain}</span>
    </span>
    <span class="post-card-arrow" aria-hidden="true">→</span>
  </a>
)}

<style>
  .post-card {
    display: flex;
    align-items: stretch;
    gap: 1rem;
    margin: 1.75rem 0;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--paper-deep);
    text-decoration: none;
    color: inherit;
    overflow: hidden;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .post-card:hover {
    border-color: var(--tech);
    box-shadow: 0 1px 6px rgba(0, 0, 0, 0.06);
  }

  .post-card-thumb {
    flex: 0 0 120px;
    width: 120px;
    height: auto;
    object-fit: cover;
    margin: 0;
  }

  .post-card-body {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 1rem 0 1rem 1rem;
  }

  .post-card:has(.post-card-thumb) .post-card-body {
    padding-left: 0;
  }

  .post-card-title {
    display: block;
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 1rem;
    color: var(--ink-soft);
    margin-bottom: 0.35rem;
  }

  .post-card-desc {
    display: block;
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--ink-soft);
    opacity: 0.75;
    /* 설명이 길어도 카드 높이가 무한정 늘어나지 않도록 2줄에서 자름 */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-card-domain {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--tech);
    margin-top: 0.5rem;
  }

  .post-card-arrow {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    padding: 0 1rem;
    font-size: 1.1rem;
    color: var(--tech);
    opacity: 0.6;
    transition: transform 0.15s ease, opacity 0.15s ease;
  }

  .post-card:hover .post-card-arrow {
    opacity: 1;
    transform: translateX(3px);
  }
</style>
