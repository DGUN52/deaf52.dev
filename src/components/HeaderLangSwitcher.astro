---
// 언어 드롭다운. 클릭으로 열고 닫힘 (hover는 버튼->메뉴로 마우스 이동 시
// 끊기기 쉬워서 사용성이 떨어지므로 클릭 토글로 변경).
import { LOCALES, LOCALE_LABELS, type Locale } from '../i18n/utils';

interface Props {
  currentLang: Locale;
  currentPath: string; // e.g. /ko/it/docker-internals
  // 현재 글(또는 페이지)에 실제로 존재하는 언어 목록.
  // 글 상세 페이지에서는 getTranslations() 결과로 정확히 계산해서 넘겨야 함.
  // 넘기지 않으면(홈/카테고리 목록처럼 특정 글에 종속되지 않는 페이지) 전체 언어를 사용 가능한 것으로 간주.
  availableLangs?: Locale[];
  // 글 상세 페이지 전용: 언어별 실제 slug 매핑 (translationKey는 같아도 파일명/slug가
  // 언어마다 다를 수 있어서, 단순히 URL의 언어 코드만 바꾸면 404가 날 수 있음).
  // 넘기지 않으면(홈/카테고리 목록 등 slug가 없는 페이지) 기존처럼 언어 코드만 교체.
  slugOverrides?: Partial<Record<Locale, string>>;
}

const {
  currentLang,
  currentPath,
  availableLangs = LOCALES as unknown as Locale[],
  slugOverrides,
} = Astro.props;

function swapLang(path: string, target: Locale) {
  const rest = path.replace(new RegExp(`^/(${LOCALES.join('|')})`), '');

  const overrideSlug = slugOverrides?.[target];
  if (overrideSlug) {
    // rest는 "/it/기존슬러그" 또는 "/it/기존슬러그/" 형태.
    // 마지막 세그먼트(슬러그)만 그 언어의 실제 slug로 교체하고, 카테고리는 그대로 유지.
    const segments = rest.split('/').filter(Boolean);
    if (segments.length >= 2) {
      segments[segments.length - 1] = overrideSlug;
      return `/${target}/${segments.join('/')}/`;
    }
  }

  return `/${target}${rest || '/'}`;
}

// Windows 등 일부 환경에서 국기 이모지가 안 뜨는 문제가 있어,
// 이모지 대신 flagcdn.com의 실제 국기 이미지(svg)를 사용한다.
// ISO 3166-1 alpha-2 국가 코드 기준 (언어 코드와 다를 수 있어 매핑 필요).
const FLAG_COUNTRY: Record<Locale, string> = {
  ko: 'kr',
  en: 'us',
  ja: 'jp',
  zh: 'cn',
  in: 'in',
  de: 'de',
  uk: 'gb',
  il: 'il',
  tw: 'tw',
};

function flagUrl(code: Locale) {
  return `https://flagcdn.com/${FLAG_COUNTRY[code]}.svg`;
}
---

<div class="lang-dropdown" id="lang-dropdown">
  <button
    type="button"
    class="lang-dropdown-btn"
    id="lang-dropdown-btn"
    aria-haspopup="listbox"
    aria-expanded="false"
  >
    <span class="flag-wrapper"><img src={flagUrl(currentLang)} alt="" class="flag-img" loading="eager" /></span>
    <span class="lang-label-full">{LOCALE_LABELS[currentLang]}</span>
    <span class="lang-label-short">{currentLang.toUpperCase()}</span>
    <span class="arrow" aria-hidden="true">▾</span>
  </button>

  <ul class="lang-dropdown-menu" id="lang-dropdown-menu" role="listbox">
    {LOCALES.map((code) => {
      const supported = availableLangs.includes(code);
      const isCurrent = code === currentLang;
      return (
        <li>
          {supported ? (
            <a
              href={swapLang(currentPath, code)}
              class="lang-item"
              class:list={[{ active: isCurrent }]}
              aria-current={isCurrent ? 'true' : undefined}
            >
              <span class="flag-wrapper"><img src={flagUrl(code)} alt="" class="flag-img" loading="lazy" /></span>
              <span>{LOCALE_LABELS[code]}</span>
            </a>
          ) : (
            <span class="lang-item disabled" aria-disabled="true">
              <span class="flag-wrapper"><img src={flagUrl(code)} alt="" class="flag-img" loading="lazy" /></span>
              <span>{LOCALE_LABELS[code]}</span>
            </span>
          )}
        </li>
      );
    })}
  </ul>
</div>

<script>
  const dropdown = document.getElementById('lang-dropdown');
  const btn = document.getElementById('lang-dropdown-btn');

  function closeDropdown() {
    dropdown?.classList.remove('open');
    btn?.setAttribute('aria-expanded', 'false');
  }

  function toggleDropdown(e: Event) {
    e.stopPropagation();
    const isOpen = dropdown?.classList.toggle('open');
    btn?.setAttribute('aria-expanded', String(!!isOpen));
  }

  btn?.addEventListener('click', toggleDropdown);

  // 드롭다운 바깥을 클릭하면 닫기
  document.addEventListener('click', (e) => {
    if (dropdown && !dropdown.contains(e.target as Node)) {
      closeDropdown();
    }
  });

  // Esc로 닫기
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeDropdown();
  });
</script>
