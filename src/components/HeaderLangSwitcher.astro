---
// HeaderLangSwitcher.astro
interface Props {
  currentLang: string;
  currentPath: string;
}

const { currentLang, currentPath } = Astro.props;

function swapLang(path: string, target: string) {
  const rest = path.replace(/^\/(ko|en|ja|zh|in|de|uk|il|tw)/, '');
  return `/${target}${rest || '/'}`;
}

const langs = [
  { 
    code: 'ko', 
    flagUrl: 'https://cdn.jsdelivr.net/gh/twitter/twemoji@14.0.2/assets/svg/1f1f0-1f1f7.svg', 
    label: '한국어',
    supported: true
  },
  { 
    code: 'en', 
    flagUrl: 'https://cdn.jsdelivr.net/gh/twitter/twemoji@14.0.2/assets/svg/1f1fa-1f1f8.svg', 
    label: 'English',
    supported: true
  },
  { 
    code: 'ja', 
    flagUrl: 'https://cdn.jsdelivr.net/gh/twitter/twemoji@14.0.2/assets/svg/1f1ef-1f1f5.svg', 
    label: '日本語',
    supported: false
  },
  { 
    code: 'zh', 
    flagUrl: 'https://cdn.jsdelivr.net/gh/twitter/twemoji@14.0.2/assets/svg/1f1e8-1f1f3.svg', 
    label: '中文',
    supported: false
  },
  { 
    code: 'in', 
    flagUrl: 'https://cdn.jsdelivr.net/gh/twitter/twemoji@14.0.2/assets/svg/1f1ee-1f1f3.svg', 
    label: 'Hindi',
    supported: false
  },
  { 
    code: 'de', 
    flagUrl: 'https://cdn.jsdelivr.net/gh/twitter/twemoji@14.0.2/assets/svg/1f1e9-1f1ea.svg', 
    label: 'Deutsch',
    supported: false
  },
  { 
    code: 'uk', 
    flagUrl: 'https://cdn.jsdelivr.net/gh/twitter/twemoji@14.0.2/assets/svg/1f1ec-1f1e7.svg', 
    label: 'English (UK)',
    supported: false
  },
  { 
    code: 'il', 
    flagUrl: 'https://cdn.jsdelivr.net/gh/twitter/twemoji@14.0.2/assets/svg/1f1ee-1f1f1.svg', 
    label: 'עברית',
    supported: false
  },
  { 
    code: 'tw', 
    flagUrl: 'https://cdn.jsdelivr.net/gh/twitter/twemoji@14.0.2/assets/svg/1f1f9-1f1fc.svg', 
    label: '繁體中文',
    supported: false
  },
];

const currentItem = langs.find((l) => l.code === currentLang) || langs[0];
---

<div class="lang-container">
  <svg class="lang-icon" viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="12" cy="12" r="10"></circle>
    <line x1="2" y1="12" x2="22" y2="12"></line>
    <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
  </svg>

  <div class="lang-dropdown">
    <button class="lang-dropdown-btn" aria-haspopup="true">
      <span class="flag-wrapper">
        <img src={currentItem.flagUrl} alt={currentItem.label} class="flag-img" />
      </span>
      <span class="arrow">▾</span>
    </button>

    <ul class="lang-dropdown-menu">
      {langs.map((l) => (
        <li>
          {l.supported ? (
            <a
              href={swapLang(currentPath, l.code)}
              class:list={[{ active: l.code === currentLang }]}
            >
              <span class="flag-wrapper">
                <img src={l.flagUrl} alt={l.label} class="flag-img" />
              </span>
              <span class="lang-name">{l.label}</span>
            </a>
          ) : (
            <span class="lang-item disabled" title="준비중 / Coming soon">
              <span class="flag-wrapper">
                <img src={l.flagUrl} alt={l.label} class="flag-img" />
              </span>
              <span class="lang-name">{l.label}</span>
              <span class="badge">준비중</span>
            </span>
          )}
        </li>
      ))}
    </ul>
  </div>
</div>