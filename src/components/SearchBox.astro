---
// Pagefind 기반 검색창. 빌드 시 `npx pagefind --site dist`로 생성된
// /pagefind/pagefind.js 를 클라이언트에서 불러와 사용한다.
// 이 파일은 astro build(Rollup) 시점엔 존재하지 않으므로, ESM import 문법을 아예 쓰지 않고
// <script type="module"> 태그를 런타임에 DOM에 직접 삽입해서 브라우저가 네이티브로 로드하게 한다.
// 이렇게 하면 Rollup/Vite가 빌드 시점에 경로를 정적 분석하지 않아 빌드가 깨지지 않는다.
---

<div class="search-box">
  <button class="search-trigger" id="search-open" aria-label="검색 열기">
    <span class="search-icon">⌕</span>
    <span class="search-label">search</span>
  </button>

  <div class="search-modal" id="search-modal" hidden>
    <div class="search-modal-backdrop" id="search-backdrop"></div>
    <div class="search-modal-panel">
      <div id="search-pagefind"></div>
      <button class="search-close" id="search-close" aria-label="검색 닫기">esc</button>
    </div>
  </div>
</div>

<script>
  const openBtn = document.getElementById('search-open');
  const closeBtn = document.getElementById('search-close');
  const backdrop = document.getElementById('search-backdrop');
  const modal = document.getElementById('search-modal');
  const mount = document.getElementById('search-pagefind');

  let initialized = false;

  function loadScriptTag(src) {
    return new Promise((resolve, reject) => {
      const tag = document.createElement('script');
      tag.type = 'module';
      tag.src = src;
      tag.onload = () => resolve();
      tag.onerror = () => reject(new Error('failed to load ' + src));
      document.head.appendChild(tag);
    });
  }

  async function initPagefind() {
    if (initialized) return;
    initialized = true;
    try {
      // pagefind.js는 로드되면 전역 window.pagefind 를 만들지 않으므로,
      // 대신 pagefind-ui.js 하나만 로드하면 PagefindUI가 전역으로 노출된다.
      await loadScriptTag('/pagefind/pagefind-ui.js');

      // @ts-ignore - PagefindUI는 위에서 로드된 스크립트가 window에 붙이는 전역 클래스
      const PagefindUI = window.PagefindUI;

      if (PagefindUI && mount) {
        new PagefindUI({ element: mount, showImages: false, resetStyles: false });
      } else if (mount) {
        mount.innerHTML = '<p class="search-fallback">검색 UI를 불러오지 못했습니다.</p>';
      }
    } catch {
      if (mount) {
        mount.innerHTML = '<p class="search-fallback">로컬 개발 환경에서는 검색이 동작하지 않습니다. 배포된 사이트에서 확인하세요.</p>';
      }
    }
  }

  function openModal() {
    modal?.removeAttribute('hidden');
    document.body.style.overflow = 'hidden';
    initPagefind();
  }

  function closeModal() {
    modal?.setAttribute('hidden', '');
    document.body.style.overflow = '';
  }

  openBtn?.addEventListener('click', openModal);
  closeBtn?.addEventListener('click', closeModal);
  backdrop?.addEventListener('click', closeModal);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeModal();
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      openModal();
    }
  });
</script>
