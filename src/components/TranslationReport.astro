---

<div class="report-box">
  <button class="report-trigger" id="report-open">{t.trigger}</button>

  <button class="report-trigger-floating" id="report-open-floating" aria-label={t.trigger}>
    <span class="report-floating-icon">⚑</span>
    <span class="report-floating-label" set:html={t.floatingLabel} />
  </button>

  <div class="report-modal" id="report-modal" hidden dir={lang === 'il' ? 'rtl' : 'ltr'}>
    <div class="report-modal-backdrop" id="report-backdrop"></div>
    <div class="report-modal-panel">
      <button class="report-close" id="report-close" aria-label={t.close}>{t.close}</button>
      <h3 class="report-title">{t.title}</h3>

      <form id="report-form">
        <div class="report-field">
          <label for="report-section">{t.sectionLabel}</label>
          <input
            type="text"
            id="report-section"
            name="section"
            placeholder={t.sectionPlaceholder}
          />
          <p class="report-hint" id="report-pick-hint">
            {t.pickPrefix} <button type="button" id="report-pick-btn" class="report-pick-btn">{t.pickBtn}</button>
          </p>
        </div>

        <div class="report-field">
          <label for="report-issue-type">{t.issueLabel}</label>
          <select id="report-issue-type" name="issueType" required>
            <option value="">{t.issuePlaceholder}</option>
            <option value="hard-to-understand">{t.issueHard}</option>
            <option value="not-translated">{t.issueNotTranslated}</option>
            <option value="wrong-meaning">{t.issueWrongMeaning}</option>
            <option value="typo">{t.issueTypo}</option>
            <option value="other">{t.issueOther}</option>
          </select>
        </div>

        <div class="report-field">
          <label for="report-comment">{t.commentLabel}</label>
          <textarea id="report-comment" name="comment" rows="3" placeholder={t.commentPlaceholder}></textarea>
        </div>

        <button type="submit" class="report-submit">{t.submit}</button>
        <p class="report-status" id="report-status"></p>
      </form>
    </div>
  </div>
</div>

<script define:vars={{ slug, lang, t }}>
  const openBtn = document.getElementById('report-open');
  const openFloatingBtn = document.getElementById('report-open-floating');
  const closeBtn = document.getElementById('report-close');
  const backdrop = document.getElementById('report-backdrop');
  const modal = document.getElementById('report-modal');
  const form = document.getElementById('report-form');
  const statusEl = document.getElementById('report-status');
  const pickBtn = document.getElementById('report-pick-btn');
  const sectionInput = document.getElementById('report-section');

  function openModal() {
    modal?.removeAttribute('hidden');
    document.body.style.overflow = 'hidden';
  }
  function closeModal() {
    modal?.setAttribute('hidden', '');
    document.body.style.overflow = '';
    exitPickMode();
  }

  openBtn?.addEventListener('click', openModal);
  openFloatingBtn?.addEventListener('click', openModal);
  closeBtn?.addEventListener('click', closeModal);
  backdrop?.addEventListener('click', closeModal);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !modal?.hasAttribute('hidden')) closeModal();
  });

  // "본문에서 클릭해서 선택" 기능: 활성화하면 모달을 잠깐 숨기고,
  // 사용자가 본문의 어떤 요소를 클릭하면 그 요소의 가까운 텍스트를 section 값으로 채운다.
  let pickModeActive = false;

  function enterPickMode() {
    pickModeActive = true;
    modal?.setAttribute('hidden', '');
    document.body.classList.add('report-picking');
    document.addEventListener('click', handlePickClick, { capture: true });
  }

  function exitPickMode() {
    if (!pickModeActive) return;
    pickModeActive = false;
    document.body.classList.remove('report-picking');
    document.removeEventListener('click', handlePickClick, { capture: true });
  }

  function handlePickClick(e) {
    if (e.target.closest('.report-box')) return;
    e.preventDefault();
    e.stopPropagation();

    const target = e.target.closest('h1, h2, h3, p, li, pre, blockquote, td, th') || e.target;
    const text = (target.textContent || '').trim().slice(0, 60);
    sectionInput.value = text ? `"${text}..."` : t.pickedFallback;

    exitPickMode();
    openModal();
  }

  pickBtn?.addEventListener('click', () => {
    enterPickMode();
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const issueType = document.getElementById('report-issue-type').value;
    const comment = document.getElementById('report-comment').value;
    const section = sectionInput.value;

    if (!issueType) {
      statusEl.textContent = t.errNoIssueType;
      return;
    }

    statusEl.textContent = t.sending;
    try {
      const res = await fetch('/api/report/translation', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ slug, lang, issueType, section: section || null, comment: comment || null }),
      });
      if (!res.ok) throw new Error('failed');
      statusEl.textContent = t.success;
      form.reset();
      setTimeout(() => {
        closeModal();
        statusEl.textContent = '';
      }, 1500);
    } catch {
      statusEl.textContent = t.failure;
    }
  });
</script>
