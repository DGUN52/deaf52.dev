{
  "name": "deaf52-dev",
  "compatibility_date": "2026-08-01",
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "COUNTERS",
      "id": "ae9fd91d856745078f3e2c43652499eb"
    }
  ],
  // Worker(worker/index.js)는 Astro 빌드와 별개 런타임이라 src/site.config.ts를 import할 수
  // 없다. 그래서 Worker가 필요로 하는 값(GitHub 콘텐츠 저장소)은 여기 vars로 별도 전달한다.
  // 포크해서 쓸 때는 이 값과 src/site.config.ts의 contentRepo를 동일하게 맞출 것.
  "vars": {
    "CONTENT_REPO": "DGUN52/deaf52.dev-content"
  }
}
